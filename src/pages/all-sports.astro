---
import Layout from '../layouts/Layout.astro';
import pagesData from '../data/pages-data.json';

const sportsPages = pagesData.filter(p => p.category === 'sports');
---

<Layout
  title="All Live Sports, Football & PPV Channels on IPTV (2026)"
  metaDescription="Stream Premier League 3PM, Champions League, Sky Sports, TNT Sports, NFL Sunday Ticket, NBA, and UFC PPV with zero buffering in 4K 60FPS."
  targetKeyword="IPTV Live Sports Channels Directory"
>
  <div class="directory-hero">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Live 4K Ultra HD Broadcasts</span>
        <h1 class="section-title">Sports, Football &amp; <span class="gradient-text">PPV Events Directory</span></h1>
        <p class="section-desc">
          Zero blackout restrictions. Stream every Premier League fixture, NFL game, NBA matchup, and combat PPV in 60FPS.
        </p>
      </div>
    </div>
  </div>

  <div class="container directory-content">
    <section class="main-sports">
      <h2>Main sports guides</h2>
      <ul class="main-sports-list">
        <li><a href="/sports/nfl-sunday-ticket">NFL Sunday Ticket</a></li>
        <li><a href="/sports/super-bowl">Super Bowl</a></li>
        <li><a href="/sports/nba-league-pass">NBA League Pass</a></li>
        <li><a href="/sports/ufc-boxing-ppv">UFC and boxing PPV</a></li>
        <li><a href="/sports/formula-1">Formula 1</a></li>
        <li><a href="/uk/sports/premier-league">Premier League</a></li>
        <li><a href="/uk/sports/sky-sports">Sky Sports</a></li>
        <li><a href="/uk/sports/tnt-sports">TNT Sports</a></li>
      </ul>
    </section>

    <div class="sports-guides-grid">
      {sportsPages.map((page) => (
        <div class="sport-card glass-card">
          <div class="sport-header">
            <span class="sport-cat-tag">{page.sportCategory || 'SPORTS'}</span>
            <span class="sport-res">🔴 4K 60FPS</span>
          </div>
          <h3>{page.sportName || page.h1}</h3>
          <p class="sport-channels">Broadcasters: <strong>{page.broadcasters || 'Sky Sports / TNT Sports / ESPN'}</strong></p>
          <a href={`/iptv/${page.slug}`} class="btn btn-secondary sport-link">
            <span>Watch Live Stream Guide</span>
            <span>&rarr;</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</Layout>

<style>
  .directory-hero {
    padding: 60px 0 30px 0;
    background: radial-gradient(circle at 50% 0%, #064e3b 0%, transparent 70%);
  }

  .directory-content {
    padding: 40px 20px 80px 20px;
  }

  .sports-guides-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .sport-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
  }

  .sport-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .sport-cat-tag {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .sport-res {
    font-size: 0.75rem;
    font-weight: 700;
    color: #f87171;
  }

  .sport-card h3 {
    font-size: 1.15rem;
    color: #ffffff;
    line-height: 1.3;
  }

  .sport-channels {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .sport-channels strong {
    color: #38bdf8;
  }

  .sport-link {
    width: 100%;
    padding: 10px 16px;
    font-size: 0.85rem;
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
  }

  @media (max-width: 1024px) {
    .sports-guides-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 650px) {
    .sports-guides-grid {
      grid-template-columns: 1fr;
    }
  }
  .main-sports { margin: 0 0 30px; }
  .main-sports h2 { font-size: 1.3rem; margin-bottom: 12px; }
  .main-sports-list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .main-sports-list a { display: inline-block; padding: 10px 16px; border-radius: 12px; background: rgba(34,211,238,0.08); border: 1px solid rgba(34,211,238,0.3); color: #cffafe; font-weight: 600; font-size: 0.92rem; }
  .main-sports-list a:hover { background: rgba(34,211,238,0.18); color: #fff; }
</style>
