---
import Layout from '../layouts/Layout.astro';
import siteConfig from '../data/site-config.json';
---

<Layout
  title="Terms of Service | 4K Subscription IPTV"
  metaDescription="Terms of service for 4K Subscription IPTV subscriptions, free trials, refunds and acceptable use."
  targetKeyword="Terms of Service"
  slug="terms-of-service"
>
  <section class="legal-page">
    <div class="container legal-wrap">
      <h1>Terms of Service</h1>
      <p class="legal-updated">Last updated: October 2026</p>

      <h2>1. Service</h2>
      <p>{siteConfig.siteName} provides access to IPTV streaming subscriptions delivered through Xtream Codes or M3U credentials. Channel and VOD counts are approximate and may change as content providers change.</p>

      <h2>2. Free trial</h2>
      <p>A 24-hour trial may be offered on request via WhatsApp. One trial per person and device. We may decline trials where abuse is suspected.</p>

      <h2>3. Payments and refunds</h2>
      <p>Plans are billed for the selected duration (1, 3, 6 or 12 months). Refund requests made within 7 days of purchase are reviewed case by case if the service cannot be made to work on your device after support has tried to help.</p>

      <h2>4. Acceptable use</h2>
      <p>Credentials are for personal use on the number of connections included in your plan. Reselling or sharing credentials without agreement may result in suspension without refund.</p>

      <h2>5. Content and responsibility</h2>
      <p>You are responsible for complying with the laws that apply where you live. All trademarks and brand names belong to their respective owners.</p>

      <h2>6. Contact</h2>
      <p>Questions: <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a> or WhatsApp {siteConfig.whatsappDisplay}.</p>
    </div>
  </section>
</Layout>

<style>
  .legal-page { padding: 60px 0 80px; }
  .legal-wrap { max-width: 820px; }
  .legal-wrap h1 { font-size: clamp(2rem, 4vw, 2.6rem); color: #fff; margin-bottom: 6px; }
  .legal-wrap h2 { font-size: 1.25rem; color: #fff; margin: 30px 0 10px; }
  .legal-wrap p { color: #cbd5e1; line-height: 1.75; }
  .legal-wrap a { color: #38bdf8; text-decoration: underline; }
  .legal-updated { color: #94a3b8 !important; font-size: 0.9rem; }
</style>
