---
import Layout from '../layouts/Layout.astro';
import hubData from '../data/hubs.json';
import { absUrl } from '../lib/url';

const usa = hubData.index.usa;
const uk = hubData.index.uk;
const totalGuides = [...usa, ...uk].reduce((n, h) => n + h.count, 0);
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Locations', url: '/all-locations' }];

const itemList = {
  '@type': 'ItemList',
  '@id': `${absUrl('/all-locations')}#hubs`,
  name: 'IPTV location guides',
  numberOfItems: usa.length + uk.length,
  itemListElement: [...usa, ...uk].map((h, i) => ({ '@type': 'ListItem', position: i + 1, name: `IPTV in ${h.name}`, url: absUrl(h.path) })),
};
---

<Layout
  title="Complete US & UK IPTV Locations Directory (1,000+ Cities & States)"
  metaDescription="Browse IPTV guides for every US state and UK region. Pick your place for device set-up, broadband speed advice, local sport and a free trial."
  targetKeyword="IPTV Locations Directory USA UK"
  pageType="CollectionPage"
  breadcrumbs={crumbs}
  extraSchema={[itemList]}
>
  <section class="loc-page">
    <div class="container">
      <header class="loc-head">
        <span class="section-badge"><i class="fa-solid fa-earth-americas"></i> Locations</span>
        <h1>IPTV guides for every <span class="gradient-text">US state and UK region</span></h1>
        <p>
          {totalGuides.toLocaleString()} local guides in {usa.length + uk.length} areas. Choose your state or region first, then your city or town for
          device set-up steps, broadband speed advice, local sport and a free-trial route.
        </p>
        <div class="loc-jump">
          <a href="#usa">United States ({usa.length} states)</a>
          <a href="#uk">United Kingdom ({uk.length} regions)</a>
        </div>
      </header>

      <section id="usa" class="loc-section">
        <h2>United States</h2>
        <ul class="loc-grid">
          {usa.map((h) => (
            <li>
              <a href={h.path} class="loc-card">
                <span class="loc-name">{h.name}</span>
                <span class="loc-count">{h.places} {h.places === 1 ? 'place' : 'places'}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section id="uk" class="loc-section">
        <h2>United Kingdom</h2>
        <ul class="loc-grid">
          {uk.map((h) => (
            <li>
              <a href={h.path} class="loc-card">
                <span class="loc-name">{h.name}</span>
                <span class="loc-count">{h.places} {h.places === 1 ? 'place' : 'places'}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="loc-section loc-help">
        <h2>Not sure where to start?</h2>
        <ul class="loc-next">
          <li><a href="/pricing">IPTV plans and prices (USA)</a></li>
          <li><a href="/uk/pricing">IPTV plans and prices (UK)</a></li>
          <li><a href="/iptv-free-trial">Free 24-hour trial</a></li>
          <li><a href="/all-devices">Device set-up guides</a></li>
          <li><a href="/tools/internet-speed-calculator">Internet speed calculator</a></li>
          <li><a href="/blog/what-is-iptv-beginners-guide">What is IPTV? A beginner guide</a></li>
        </ul>
      </section>
    </div>
  </section>
</Layout>

<style>
  .loc-page { padding: clamp(24px, 5vw, 56px) 0 clamp(40px, 7vw, 80px); }
  .loc-head { max-width: 820px; margin-bottom: 8px; }
  .loc-head h1 { margin: 12px 0 14px; }
  .loc-head p { color: #cbd5e1; line-height: 1.75; }
  .loc-jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .loc-jump a { padding: 10px 16px; border-radius: 9999px; background: rgba(79,140,255,0.14); border: 1px solid rgba(79,140,255,0.35); color: #bcd3ff; font-weight: 600; font-size: 0.9rem; }
  .loc-jump a:hover { background: rgba(79,140,255,0.3); color: #fff; }
  .loc-section { margin-top: 40px; scroll-margin-top: 130px; }
  .loc-section h2 { font-size: clamp(1.3rem, 2.6vw, 1.8rem); margin-bottom: 16px; }
  .loc-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 10px; }
  .loc-card { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 16px; border-radius: 12px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); min-height: 52px; transition: all 0.2s; }
  .loc-card:hover { background: rgba(79,140,255,0.14); border-color: rgba(79,140,255,0.45); transform: translateY(-2px); }
  .loc-name { font-weight: 600; color: #f1f5f9; overflow-wrap: anywhere; min-width: 0; }
  .loc-count { font-size: 0.75rem; color: #94a3b8; white-space: nowrap; }
  .loc-next { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .loc-next a { display: inline-block; padding: 10px 16px; border-radius: 12px; background: rgba(34,211,238,0.08); border: 1px solid rgba(34,211,238,0.3); color: #cffafe; font-weight: 600; font-size: 0.92rem; }
  .loc-next a:hover { background: rgba(34,211,238,0.18); color: #fff; }
</style>
