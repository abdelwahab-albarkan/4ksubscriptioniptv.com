---
import Layout from '../layouts/Layout.astro';
import siteConfig from '../data/site-config.json';
import { fromUsd } from '../lib/pricing';

const popularLinks = [
  { title: "IPTV Pricing & Plans", url: "/pricing", icon: "fa-tags", desc: "US & Global IPTV subscriptions from " + fromUsd + "/mo" },
  { title: "UK IPTV & Premier League", url: "/uk/pricing", icon: "fa-futbol", desc: "UK optimized feeds with 3PM blackout bypass" },
  { title: "Firestick 4K Setup Guide", url: "/devices/firestick", icon: "fa-fire", desc: "3-minute step-by-step sideloading tutorial" },
  { title: "Browse 1,600+ City Pages", url: "/all-locations", icon: "fa-globe", desc: "Localized IPTV servers across USA & UK" },
  { title: "Sports & PPV Channels", url: "/all-sports", icon: "fa-trophy", desc: "NFL, NBA, UFC, Premier League & Champions League" },
  { title: "Reseller Panel Guide", url: "/#reseller-section", icon: "fa-store", desc: "Launch your white-label IPTV business" }
];
---

<Layout
  title="404 - Page Not Found | 4KSubscriptionIPTV"
  metaDescription="The IPTV streaming page or guide you are looking for has been moved or updated. Explore our top 4K IPTV plans, setup guides, and regional servers."
  canonicalUrl={`${siteConfig.domain}/404`}
>
  <div class="error-page-container">
    <div class="container">
      <div class="error-hero glass-card text-center">
        <div class="error-glitch-badge">404 ERROR</div>
        <h1 class="error-title">Stream Feed <span class="gradient-text">Not Found</span></h1>
        <p class="error-subtitle">
          The channel, city guide, or setup tutorial you were trying to access might have been updated, relocated, or temporarily re-routed through our CDN edge servers.
        </p>

        <div class="error-actions">
          <a href="/" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-house"></i> Return to Homepage
          </a>
          <a href={siteConfig.whatsappUrl} class="btn btn-outline btn-lg" target="_blank" rel="noopener">
            <i class="fa-brands fa-whatsapp"></i> Contact 24/7 Support
          </a>
        </div>
      </div>

      <!-- Popular Destinations -->
      <div class="popular-destinations-section">
        <div class="section-header text-center">
          <span class="section-badge"><i class="fa-solid fa-compass"></i> Popular Destinations</span>
          <h2 class="section-title">Looking for One of These Live Streams?</h2>
        </div>

        <div class="destinations-grid">
          {popularLinks.map((link) => (
            <a href={link.url} class="dest-card glass-card">
              <div class="dest-icon-wrap">
                <i class={`fa-solid ${link.icon}`}></i>
              </div>
              <div class="dest-content">
                <h3>{link.title}</h3>
                <p>{link.desc}</p>
              </div>
              <div class="dest-arrow">
                <i class="fa-solid fa-arrow-right"></i>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .error-page-container {
    padding: 60px 0 100px;
  }

  .error-hero {
    max-width: 760px;
    margin: 0 auto 60px;
    padding: 60px 30px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: radial-gradient(circle at 50% 0%, rgba(59, 130, 246, 0.15) 0%, rgba(13, 20, 38, 0.8) 100%);
  }

  .error-glitch-badge {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 3px;
    color: #f43f5e;
    background: rgba(244, 63, 94, 0.15);
    padding: 6px 16px;
    border-radius: 9999px;
    border: 1px solid rgba(244, 63, 94, 0.3);
    margin-bottom: 20px;
  }

  .error-title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    margin-bottom: 16px;
    line-height: 1.15;
  }

  .error-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 35px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .error-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .popular-destinations-section {
    margin-top: 40px;
  }

  .destinations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 20px;
    margin-top: 30px;
  }

  .dest-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px 24px;
    border-radius: 18px;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.3s ease;
  }

  .dest-card:hover {
    transform: translateY(-4px);
    border-color: rgba(59, 130, 246, 0.4);
    background: rgba(30, 41, 59, 0.7);
  }

  .dest-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(6, 182, 212, 0.2) 100%);
    border: 1px solid rgba(59, 130, 246, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #38bdf8;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .dest-content {
    flex: 1;
  }

  .dest-content h3 {
    font-size: 1.05rem;
    color: #ffffff;
    margin-bottom: 4px;
    font-weight: 700;
  }

  .dest-content p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
  }

  .dest-arrow {
    color: var(--text-muted);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .dest-card:hover .dest-arrow {
    transform: translateX(4px);
    color: #38bdf8;
  }
</style>
