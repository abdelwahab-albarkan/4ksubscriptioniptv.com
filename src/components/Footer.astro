---
import siteConfig from '../data/site-config.json';

import hubData from '../data/hubs.json';
const topStates = [...hubData.hubs].filter((h) => h.type === 'us-state').sort((a, b) => b.count - a.count).slice(0, 8);
const topRegions = [...hubData.hubs].filter((h) => h.type === 'uk-region').sort((a, b) => b.count - a.count).slice(0, 4);
const social = (siteConfig as any).social || {};
const socialMeta = [
  { key: 'instagram', label: 'Instagram', icon: 'fa-brands fa-instagram' },
  { key: 'facebook', label: 'Facebook', icon: 'fa-brands fa-facebook-f' },
  { key: 'telegram', label: 'Telegram', icon: 'fa-brands fa-telegram' },
  { key: 'youtube', label: 'YouTube', icon: 'fa-brands fa-youtube' },
  { key: 'x', label: 'X', icon: 'fa-brands fa-x-twitter' },
  { key: 'discord', label: 'Discord', icon: 'fa-brands fa-discord' },
];
const socials = socialMeta.filter((m) => social[m.key]).map((m) => ({ ...m, url: social[m.key] }));
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top-grid">
      
      <!-- Brand Col -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo">
          <div class="footer-logo-icon">
            <i class="fa-solid fa-bolt-lightning"></i>
          </div>
          <div class="footer-logo-text">
            <span class="footer-brand-name">4K<span class="accent-text">Subscription</span> <span class="badge-pro">IPTV</span></span>
            <span class="footer-tag">Enterprise 4K &amp; Reseller Network</span>
          </div>
        </a>
        <p class="footer-bio">
          The premier 4K/8K IPTV streaming platform and wholesale reseller infrastructure for 2026. Delivering ultra-low latency, uncompressed sports feeds, and high-profit reseller solutions across the USA, UK, Europe, Canada, and Australia.
        </p>
        <div class="footer-contact-badge">
          <i class="fa-brands fa-whatsapp text-whatsapp"></i>
          <span>WhatsApp 24/7 Desk: <strong>{siteConfig.whatsappDisplay}</strong></span>
        </div>
        {socials.length > 0 && (
          <div class="footer-social" aria-label="Social links">
            {socials.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="footer-social-link">
                <i class={s.icon}></i>
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Providers Links -->
      <div class="footer-col">
        <h4 class="footer-heading"><i class="fa-solid fa-server"></i> Our Network Hubs</h4>
        <ul class="footer-links">
          <li><a href="https://streamb4.com" target="_blank" rel="noopener nofollow sponsored"><i class="fa-solid fa-bolt-lightning"></i> StreamB4 <span class="badge-mini">#1</span></a></li>
          <li><a href="https://ukstream4k.com" target="_blank" rel="noopener nofollow sponsored"><i class="fa-solid fa-futbol"></i> UK Stream 4K <span class="badge-mini">UK</span></a></li>
          <li><a href="https://rokustream.com" target="_blank" rel="noopener nofollow sponsored"><i class="fa-solid fa-tv"></i> Roku Stream</a></li>
          <li><a href="https://ultra8kiptv.org" target="_blank" rel="noopener nofollow sponsored"><i class="fa-solid fa-gem"></i> Ultra 8K IPTV <span class="badge-mini">8K</span></a></li>
          <li><a href="https://tvnado2026.com" target="_blank" rel="noopener nofollow sponsored"><i class="fa-solid fa-gauge-high"></i> Tvnado 2026</a></li>
          <li><a href="https://iptvsmarters-tv.fr" target="_blank" rel="noopener nofollow sponsored"><i class="fa-solid fa-tower-broadcast"></i> IPTV Smarters FR</a></li>
          <li><a href="https://4kgermaniptv.com" target="_blank" rel="noopener nofollow sponsored"><i class="fa-solid fa-trophy"></i> 4K German IPTV</a></li>
          <li><a href="https://agencyfluxly.com" target="_blank" rel="noopener nofollow sponsored"><i class="fa-solid fa-briefcase"></i> Agency Fluxly</a></li>
        </ul>
      </div>

      <!-- Reseller & Guides -->
      <div class="footer-col">
        <h4 class="footer-heading"><i class="fa-solid fa-book-open"></i> Guides &amp; Reseller</h4>
        <ul class="footer-links">
          <li><a href="/blog"><i class="fa-solid fa-graduation-cap"></i> All Knowledge Guides</a></li>
          <li><a href="/blog/how-to-setup-iptv-firestick-2026"><i class="fa-brands fa-amazon"></i> Firestick 4K Setup</a></li>
          <li><a href="/blog/best-iptv-apps-comparison-tivimate-vs-smarters"><i class="fa-solid fa-tv"></i> TiviMate vs Smarters</a></li>
          <li><a href="/blog/how-to-fix-iptv-buffering-isp-throttling"><i class="fa-solid fa-bolt"></i> Fix ISP Buffering</a></li>
          <li><a href="/blog/start-iptv-reseller-business-guide"><i class="fa-solid fa-chart-line"></i> Reseller Business Guide</a></li>
          <li><a href="/#reseller-section"><i class="fa-solid fa-store"></i> Reseller Panel Rates</a></li>
        </ul>
      </div>

      <!-- Regional Markets & Languages -->
      <div class="footer-col">
        <h4 class="footer-heading"><i class="fa-solid fa-globe"></i> Regions &amp; Languages</h4>
        <ul class="footer-links">
          <li><a href="/pricing"><img class="flag-mini" src="/flags/us.svg" alt="" width="18" height="18" loading="lazy" /> USA ($ USD)</a></li>
          <li><a href="/uk/pricing"><img class="flag-mini" src="/flags/gb.svg" alt="" width="18" height="18" loading="lazy" /> UK (£ GBP)</a></li>
          <li><a href="/de"><img class="flag-mini" src="/flags/de.svg" alt="" width="18" height="18" loading="lazy" /> Deutschland (€ EUR)</a></li>
          <li><a href="/fr"><img class="flag-mini" src="/flags/fr.svg" alt="" width="18" height="18" loading="lazy" /> France (€ EUR)</a></li>
          <li><a href="/es"><img class="flag-mini" src="/flags/es.svg" alt="" width="18" height="18" loading="lazy" /> España (€ EUR)</a></li>
          <li><a href="/all-locations"><i class="fa-solid fa-location-dot"></i> 1,600+ City Hubs</a></li>
          <li><a href="/all-sports"><i class="fa-solid fa-futbol"></i> Sports &amp; PPV Directory</a></li>
        </ul>
      </div>

    </div>

    <!-- Browse by location (internal links to the hub pages) -->
    <div class="footer-locations">
      <h4 class="footer-heading"><i class="fa-solid fa-location-dot"></i> Browse IPTV by location</h4>
      <ul>
        {topStates.map((h) => <li><a href={h.path}>{h.name}</a></li>)}
        {topRegions.map((h) => <li><a href={h.path}>{h.name} (UK)</a></li>)}
        <li><a href="/all-locations" class="footer-all-loc">All locations</a></li>
      </ul>
      <ul class="footer-extra-links">
        <li><a href="/blog">Blog and tutorials</a></li>
        <li><a href="/guides">Topic guides</a></li>
        <li><a href="/tools">Free tools</a></li>
        <li><a href="/all-devices">Device guides</a></li>
        <li><a href="/all-sports">Sports guides</a></li>
        <li><a href="/brand">Brand and press</a></li>
      </ul>
    </div>

    <!-- Disclaimer & Bottom bar -->
    <div class="footer-disclaimer">
      <p>
        <strong>Legal Disclaimer:</strong> {siteConfig.siteName} provides high-performance IPTV infrastructure, Xtream Codes API integration, and wholesale reseller solutions. All trademarks, channel logos, and league brand names belong to their respective copyright holders.
      </p>
    </div>

    <div class="footer-bottom">
      <div class="footer-copy">
        &copy; 2026 {siteConfig.siteName}. All rights reserved. Powered by High-Speed Edge CDN.
      </div>
      <div class="footer-legal-links">
        <a href="/about">About</a>
        <span class="sep">&bull;</span>
        <a href="/faq">FAQ</a>
        <span class="sep">&bull;</span>
        <a href="/privacy-policy">Privacy</a>
        <span class="sep">&bull;</span>
        <a href="/terms-of-service">Terms</a>
        <span class="sep">&bull;</span>
        <a href="/refund-policy">Refunds</a>
        <span class="sep">&bull;</span>
        <a href="/cookie-policy">Cookies</a>
        <span class="sep">&bull;</span>
        <a href="/contact">Contact</a>
        <span class="sep">&bull;</span>
        <a href="/sitemap.xml">XML Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #04060c;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 70px 0 30px 0;
    font-size: 0.88rem;
    color: #94a3b8;
  }

  .footer-top-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 36px;
    margin-bottom: 40px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    text-decoration: none;
  }

  .footer-logo-icon {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 1.1rem;
  }

  .footer-brand-name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.2rem;
    color: #ffffff;
  }

  .accent-text {
    color: #38bdf8;
  }

  .footer-tag {
    display: block;
    font-size: 0.68rem;
    color: #64748b;
  }

  .footer-bio {
    font-size: 0.86rem;
    line-height: 1.6;
    color: #94a3b8;
    margin-bottom: 16px;
  }

  .footer-contact-badge {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 8px 14px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: #cbd5e1;
  }

  .text-whatsapp {
    color: #25d366;
    font-size: 1.1rem;
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: #ffffff;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer-heading i {
    color: #38bdf8;
    font-size: 0.85rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .footer-links li a {
    color: #94a3b8;
    font-size: 0.86rem;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
  }

  .footer-links li a i {
    font-size: 0.78rem;
    width: 14px;
    color: #64748b;
  }

  .footer-links li a:hover {
    color: #ffffff;
    padding-left: 4px;
  }

  .footer-links li a:hover i {
    color: #38bdf8;
  }

  .badge-mini {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 9999px;
    background: rgba(245, 158, 11, 0.2);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .footer-disclaimer {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 24px;
    margin-bottom: 24px;
    font-size: 0.78rem;
    line-height: 1.55;
    color: #64748b;
  }

  .footer-disclaimer strong {
    color: #94a3b8;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.8rem;
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer-legal-links a {
    color: #94a3b8;
    transition: color 0.2s;
  }

  .footer-legal-links a:hover {
    color: #38bdf8;
  }

  .sep {
    color: rgba(255, 255, 255, 0.15);
  }

  @media (max-width: 992px) {
    .footer-top-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-top-grid {
      grid-template-columns: 1fr;
    }
  }

  img.flag-mini {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    object-fit: cover;
    display: inline-block;
    vertical-align: middle;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25);
  }

  .footer-social {
    display: flex;
    gap: 10px;
    margin-top: 14px;
  }

  .footer-social-link {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    transition: all 0.2s ease;
  }

  .footer-social-link:hover {
    background: rgba(79, 140, 255, 0.2);
    border-color: rgba(79, 140, 255, 0.5);
    color: #fff;
    transform: translateY(-2px);
  }

  .footer-legal-links {
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .footer-locations { margin: 8px 0 26px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.08); }
  .footer-locations ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 12px 0 0; }
  .footer-locations a { display: inline-flex; align-items: center; min-height: 38px; padding: 6px 14px; border-radius: 9999px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); color: #cbd5e1; font-size: 0.85rem; transition: all 0.2s; }
  .footer-locations a:hover { background: rgba(79,140,255,0.18); border-color: rgba(79,140,255,0.5); color: #fff; }
  .footer-locations .footer-all-loc { border-color: rgba(79,140,255,0.5); color: #bcd3ff; font-weight: 600; }
  .footer-locations .footer-extra-links a { background: rgba(34,211,238,0.06); border-color: rgba(34,211,238,0.25); }
</style>
