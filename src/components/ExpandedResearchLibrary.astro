<!-- ==================== EXPANDED RESEARCH LIBRARY ==================== -->
<section class="kf-section kf-section--tint" id="expanded-research-library">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-badge"><i class="fa-solid fa-layer-group"></i> Expanded 2026 Edition</span>
      <h2 class="section-title">Explore the 1,600+ Page IPTV &amp; Reseller Research Hub</h2>
      <p class="section-description">
        Reseller operations, provider audits, lab protocols, head-to-head comparisons, player apps, device setup guides, and hyper-local UK &amp; US geographic landing pages.
      </p>
    </div>

    <div class="kf-grid">
      {libraryCards.map((c) => (
        <article class="kf-card glass-card">
          <div class="kf-card__icon">{c.count}</div>
          <h3>{c.title}</h3>
          <p>{c.desc}</p>
          <a class="kf-card__link" href={c.linkUrl}>{c.linkText}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .kf-section--tint {
    padding: 80px 0;
    background: rgba(11, 17, 34, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .kf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 20px;
  }

  .kf-card {
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .kf-card:hover {
    transform: translateY(-5px);
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  }

  .kf-card__icon {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 800;
    color: #38bdf8;
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.3);
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .kf-card h3 {
    font-size: 1.1rem;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .kf-card p {
    font-size: 0.84rem;
    color: #94a3b8;
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .kf-card__link {
    margin-top: auto;
    font-size: 0.82rem;
    font-weight: 700;
    color: #38bdf8;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s;
  }

  .kf-card__link:hover {
    color: #60a5fa;
  }
</style>
