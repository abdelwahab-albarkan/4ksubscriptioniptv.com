---
// Shared wrapper for plain content pages (About, Refund, Cookies...).
interface Props {
  h1: string;
  updated?: string;
  lead?: string;
}
const { h1, updated, lead } = Astro.props;
---

<section class="legal-page">
  <div class="container legal-wrap">
    <h1>{h1}</h1>
    {updated && <p class="legal-updated">Last updated: {updated}</p>}
    {lead && <p class="legal-lead">{lead}</p>}
    <slot />
  </div>
</section>

<style is:global>
  .legal-page { padding: clamp(40px, 7vw, 72px) 0 80px; }
  .legal-wrap { max-width: 820px; }
  .legal-wrap h1 { font-size: clamp(2rem, 4vw, 2.6rem); color: #fff; margin-bottom: 8px; }
  .legal-wrap h2 { font-size: 1.25rem; color: #fff; margin: 30px 0 10px; }
  .legal-wrap p, .legal-wrap li { color: #cbd5e1; line-height: 1.75; }
  .legal-wrap p + p { margin-top: 10px; }
  .legal-wrap ul, .legal-wrap ol { margin: 10px 0 0 1.2rem; display: grid; gap: 6px; }
  .legal-wrap a:not(.btn) { color: #38bdf8; text-decoration: underline; }
  .legal-updated { color: #94a3b8 !important; font-size: 0.9rem; }
  .legal-lead { font-size: 1.08rem; margin: 14px 0 6px; }
  .legal-actions { display: flex; flex-wrap: wrap; gap: 14px; margin: 26px 0; }
  .legal-actions .btn { max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
</style>
