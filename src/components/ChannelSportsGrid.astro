---
// Channel & Sports Coverage Component with Real Photography
---

<section class="channels-section" id="channels">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-badge"><i class="fa-solid fa-futbol"></i> Unmatched Live Broadcasts</span>
      <h2 class="section-title">51,000+ Premium <span class="gradient-text">Live Channels &amp; Sports</span> (2026)</h2>
      <p class="section-description">
        Watch all live sports in true 4K UHD &amp; 60FPS. No geo-blocks, no blackout restrictions, and zero lag across UK, USA, Europe, Canada, and Australia.
      </p>
    </div>

    <!-- Category Tabs Filter -->
    <div class="channel-tabs" id="channel-tabs-container">
      <button class="tab-btn active" data-tab="uk-sports"><i class="fa-solid fa-landmark-flag"></i> UK Sports &amp; Entertainment</button>
      <button class="tab-btn" data-tab="us-sports"><i class="fa-solid fa-flag-usa"></i> USA Sports &amp; Networks</button>
      <button class="tab-btn" data-tab="ppv-events"><i class="fa-solid fa-hand-fist"></i> Live PPV &amp; Combat</button>
      <button class="tab-btn" data-tab="motorsport"><i class="fa-solid fa-car-burst"></i> F1, Cricket &amp; Global</button>
      <button class="tab-btn" data-tab="movies-vod"><i class="fa-solid fa-film"></i> 200k+ Movies &amp; Series</button>
    </div>

    <!-- Tab 1: UK Channels -->
    <div class="tab-content active" id="tab-uk-sports">
      <div class="tab-media-hero">
        <div class="tab-hero-img-wrap">
          <img 
            src="/images/packimages2/lucid-origin_Dramatic_wide_night_photo_of_a_packed_football_stadium_floodlights_green_pitch_p-0.jpg" 
            alt="Live Premier League Football 4K Packed Stadium" 
            class="tab-hero-img" 
            loading="lazy" 
          />
          <div class="tab-hero-overlay">
            <span class="tab-hero-badge"><i class="fa-solid fa-trophy"></i> 3PM Blackout Unlocked</span>
            <h3>Premier League &amp; UEFA Champions League</h3>
            <p>Every single live fixture broadcast in uncompressed 4K 50/60FPS with Sky Sports &amp; TNT Sports multi-audio feeds.</p>
          </div>
        </div>
      </div>

      <div class="channels-grid">
        <div class="channel-card glass-card">
          <div class="channel-badge live">4K UHD</div>
          <h4>Sky Sports Premier League</h4>
          <p>Every live Premier League match, tactical analysis &amp; dedicated 24/7 football coverage.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge live">4K UHD</div>
          <h4>Sky Sports Main Event</h4>
          <p>Top live broadcasts: Premier League, F1, Cricket, Golf &amp; Super Sunday.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge live">4K HDR</div>
          <h4>TNT Sports 1, 2, 3 &amp; 4</h4>
          <p>Champions League, Europa League, Serie A, Premiership Rugby &amp; MotoGP.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge fhd">FHD 50FPS</div>
          <h4>3PM Premier League Blackouts</h4>
          <p>Full access to all Saturday 3PM fixtures unavailable on standard UK cable broadcast.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge fhd">FHD 50FPS</div>
          <h4>Sky Sports F1 4K</h4>
          <p>Every Practice, Qualifying session and Grand Prix race live in crystal-clear 50FPS.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge fhd">1080p FHD</div>
          <h4>BBC 1-4 &amp; ITV 1-4</h4>
          <p>Full UK terrestrial TV in crystal HD with 7-Day interactive EPG &amp; catchup.</p>
        </div>
      </div>
    </div>

    <!-- Tab 2: US Channels -->
    <div class="tab-content" id="tab-us-sports">
      <div class="tab-media-hero">
        <div class="tab-hero-img-wrap">
          <img 
            src="/images/packimages2/lucid-origin_American_football_stadium_at_night_quarterback_about_to_throw_linemen_in_motion_-0.jpg" 
            alt="NFL Sunday Ticket & US Sports Live Stadium" 
            class="tab-hero-img" 
            loading="lazy" 
          />
          <div class="tab-hero-overlay">
            <span class="tab-hero-badge"><i class="fa-solid fa-football"></i> All Major US Leagues</span>
            <h3>NFL Sunday Ticket, NBA, MLB &amp; NHL</h3>
            <p>Every out-of-market matchup, RedZone, ESPN+, and regional sports networks with 0 blackouts.</p>
          </div>
        </div>
      </div>

      <div class="channels-grid">
        <div class="channel-card glass-card">
          <div class="channel-badge live">4K UHD</div>
          <h4>NFL Sunday Ticket &amp; RedZone</h4>
          <p>Every touchdown from every game on Sunday afternoon with zero commercial interruptions.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge live">60FPS</div>
          <h4>ESPN, ESPN2 &amp; ESPN+</h4>
          <p>Monday Night Football, College Sports, NBA on ESPN, MLB and SportsCenter.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge live">60FPS</div>
          <h4>Fox Sports 1 (FS1) &amp; FS2 4K</h4>
          <p>College Football, NASCAR, MLB, World Cup qualifiers and studio coverage.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge fhd">FHD 60FPS</div>
          <h4>NBA League Pass &amp; NBA TV</h4>
          <p>Out-of-market games, playoffs, NBA Finals and 24/7 dedicated basketball analysis.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge fhd">FHD 60FPS</div>
          <h4>MLB Extra Innings &amp; World Series</h4>
          <p>Live baseball games every night, regional sports networks (RSNs) included.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge fhd">FHD 60FPS</div>
          <h4>NHL Center Ice &amp; Stanley Cup</h4>
          <p>Live hockey feeds for all 32 NHL teams with home and away commentary options.</p>
        </div>
      </div>
    </div>

    <!-- Tab 3: PPV Events -->
    <div class="tab-content" id="tab-ppv-events">
      <div class="tab-media-hero">
        <div class="tab-hero-img-wrap">
          <img 
            src="/images/packimages2/lucid-origin_Fighter_in_a_boxing_ring_seen_from_behind_glove_raised_arena_lights_and_smoke_cr-0.jpg" 
            alt="Live UFC and Championship Boxing in Ring" 
            class="tab-hero-img" 
            loading="lazy" 
          />
          <div class="tab-hero-overlay">
            <span class="tab-hero-badge"><i class="fa-solid fa-hand-fist"></i> 100% Free PPV Access</span>
            <h3>UFC Main Cards, DAZN Boxing &amp; WWE PPVs</h3>
            <p>Save over $1,200/year on pay-per-view fees. All major title fights stream live with no extra charges.</p>
          </div>
        </div>
      </div>

      <div class="channels-grid">
        <div class="channel-card glass-card">
          <div class="channel-badge live">ALL INCLUDED</div>
          <h4>UFC Main Cards &amp; Early Prelims</h4>
          <p>All UFC PPVs (UFC 310, 311, 312...) included free with zero pay-per-view fees.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge live">ALL INCLUDED</div>
          <h4>DAZN Boxing &amp; Riyadh Season</h4>
          <p>Fury, Usyk, Joshua, Canelo, Beterbiev &amp; Bivol championship bouts live in 4K.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge live">60FPS</div>
          <h4>WWE Network &amp; AEW Pay-Per-Views</h4>
          <p>WrestleMania, Royal Rumble, SummerSlam, AEW All In and weekly Raw/SmackDown.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge live">60FPS</div>
          <h4>Bare Knuckle FC (BKFC) &amp; PFL MMA</h4>
          <p>Complete global combat sports feeds including ONE Championship and Glory Kickboxing.</p>
        </div>
      </div>
    </div>

    <!-- Tab 4: Motorsport & Global Sports -->
    <div class="tab-content" id="tab-motorsport">
      <div class="tab-media-hero">
        <div class="tab-hero-img-wrap">
          <img 
            src="/images/packimages2/lucid-origin_Formula-style_open-wheel_racing_car_at_night_on_a_city_circuit_motion_blur_neon_-0.jpg" 
            alt="Formula 1 Night Circuit Grand Prix" 
            class="tab-hero-img" 
            loading="lazy" 
          />
          <div class="tab-hero-overlay">
            <span class="tab-hero-badge"><i class="fa-solid fa-car-burst"></i> Worldwide High-Octane</span>
            <h3>Formula 1, Cricket World Cup, AFL &amp; Rugby</h3>
            <p>High-framerate 60FPS feeds with team pit radios, multi-track audio, and international commentary.</p>
          </div>
        </div>
      </div>

      <div class="channels-grid">
        <div class="channel-card glass-card">
          <div class="channel-badge live">4K 60FPS</div>
          <h4>Formula 1 Grand Prix 4K</h4>
          <p>Every Practice, Qualifying, Sprint and Grand Prix race with multi-screen cockpit feeds.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge live">LIVE CRICKET</div>
          <h4>ICC Cricket, IPL &amp; The Ashes</h4>
          <p>Willow TV, Sky Cricket, Fox Cricket with full Australian, Indian and UK test matches.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge live">60FPS</div>
          <h4>MotoGP, WorldSBK &amp; IndyCar</h4>
          <p>Full international two-wheel and open-wheel racing series in full high definition.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge live">AU &amp; NZ</div>
          <h4>AFL, NRL &amp; Super Rugby</h4>
          <p>Complete coverage of Australian and New Zealand contact sports with local audio commentary.</p>
        </div>
      </div>
    </div>

    <!-- Tab 5: VOD Movies -->
    <div class="tab-content" id="tab-movies-vod">
      <div class="tab-media-hero">
        <div class="tab-hero-img-wrap">
          <img 
            src="/images/packimages2/photo_2025-08-23_12-37-32_cleanup.webp" 
            alt="200,000+ Movies & Series VOD Cinema Library" 
            class="tab-hero-img" 
            loading="lazy" 
          />
          <div class="tab-hero-overlay">
            <span class="tab-hero-badge"><i class="fa-solid fa-clapperboard"></i> Updated Daily</span>
            <h3>Cinema 4K VOD &amp; Streaming Platforms</h3>
            <p>Netflix, Amazon Prime, Apple TV+, Disney+, HBO Max, Paramount+, and cinema blockbusters.</p>
          </div>
        </div>
      </div>

      <div class="channels-grid">
        <div class="channel-card glass-card">
          <div class="channel-badge live">4K HDR</div>
          <h4>Latest Cinema Releases (2026)</h4>
          <p>Instant access to theatrical movies in 4K HDR with Dolby Atmos 5.1 audio.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge live">COMPLETE SEASONS</div>
          <h4>Trending TV Series &amp; Miniseries</h4>
          <p>All seasons and episodes of top-rated global series with multi-language subs.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge live">MULTI-AUDIO</div>
          <h4>International &amp; Multi-Language VOD</h4>
          <p>French, Spanish, Arabic, German, Italian, and Turkish dubbed &amp; subbed films.</p>
        </div>
        <div class="channel-card glass-card">
          <div class="channel-badge live">KIDS &amp; FAMILY</div>
          <h4>Disney, Pixar &amp; Animation</h4>
          <p>Complete animated collections, family movies, and educational documentaries.</p>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  const tabButtons = document.querySelectorAll('#channel-tabs-container .tab-btn');
  const tabContents = document.querySelectorAll('.channels-section .tab-content');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetTab = btn.getAttribute('data-tab');

      tabButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      tabContents.forEach((c) => {
        if (c.id === `tab-${targetTab}`) {
          c.classList.add('active');
        } else {
          c.classList.remove('active');
        }
      });
    });
  });
</script>

<style>
  .channels-section {
    padding: 85px 0;
  }

  .channel-tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin: 30px 0 40px 0;
  }

  .tab-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    padding: 10px 20px;
    border-radius: 9999px;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: inherit;
  }

  .tab-btn:hover {
    background: rgba(59, 130, 246, 0.15);
    color: #ffffff;
    border-color: rgba(59, 130, 246, 0.35);
  }

  .tab-btn.active {
    background: linear-gradient(135deg, #2563eb 0%, #0284c7 100%);
    color: #ffffff;
    border-color: rgba(59, 130, 246, 0.5);
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
  }

  .tab-content {
    display: none;
    animation: fadeIn 0.3s ease;
  }

  .tab-content.active {
    display: block;
  }

  .tab-media-hero {
    margin-bottom: 30px;
  }

  .tab-hero-img-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    height: 320px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
  }

  .tab-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    transition: transform 0.6s ease;
  }

  .tab-hero-img-wrap:hover .tab-hero-img {
    transform: scale(1.04);
  }

  .tab-hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(6, 10, 22, 0.95) 0%, rgba(6, 10, 22, 0.6) 60%, transparent 100%);
    padding: 30px;
  }

  .tab-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(245, 158, 11, 0.2);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: #fbbf24;
    padding: 4px 12px;
    border-radius: 9999px;
    font-size: 0.76rem;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .tab-hero-overlay h3 {
    font-size: 1.6rem;
    color: #ffffff;
    font-weight: 800;
    margin-bottom: 6px;
  }

  .tab-hero-overlay p {
    font-size: 0.92rem;
    color: #cbd5e1;
    max-width: 700px;
    line-height: 1.5;
  }

  .channels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }

  .channel-card {
    background: rgba(13, 20, 38, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 22px;
    position: relative;
    transition: all 0.25s ease;
  }

  .channel-card:hover {
    transform: translateY(-4px);
    border-color: rgba(59, 130, 246, 0.35);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  }

  .channel-badge {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 9999px;
    font-size: 0.68rem;
    font-weight: 800;
    margin-bottom: 12px;
  }

  .channel-badge.live {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
  }

  .channel-badge.fhd {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.4);
    color: #60a5fa;
  }

  .channel-card h4 {
    font-size: 1.05rem;
    color: #ffffff;
    margin-bottom: 6px;
    font-weight: 700;
  }

  .channel-card p {
    font-size: 0.82rem;
    color: #94a3b8;
    line-height: 1.5;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .tab-hero-img-wrap {
      height: 240px;
    }
    .tab-hero-overlay {
      padding: 18px;
    }
    .tab-hero-overlay h3 {
      font-size: 1.25rem;
    }
    .tab-btn {
      font-size: 0.78rem;
      padding: 8px 14px;
    }
  }
</style>
