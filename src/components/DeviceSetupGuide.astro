---
import siteConfig from '../data/site-config.json';

interface Props {
  deviceName?: string;
  recommendedApp?: string;
  setupTime?: string;
}

const {
  deviceName = "Amazon Firestick & Smart TV",
  recommendedApp = "IPTV Smarters Pro / TiviMate",
  setupTime = "2 minutes"
} = Astro.props;

// Hardware Real Photography Showcase
const hardwareSpotlights = [
  {
    title: "Amazon Firestick 4K & Android Stick",
    sub: "Direct HDMI plug-and-play with Alexa voice remote and hardware HEVC decoding.",
    img: "/images/packimages2/Gemini_Generated_Image_fjow55fjow55fjow.jpg",
    badge: "Most Popular",
    speed: "< 2 Mins Setup"
  },
  {
    title: "Dedicated 4K Android Box & Apple TV",
    sub: "Gigabit Ethernet port, 4GB RAM buffer, and Dolby Vision passthrough support.",
    img: "/images/packimages2/Gemini_Generated_Image_razn6trazn6trazn.jpg",
    badge: "Ultra HD 60FPS",
    speed: "No Buffering"
  },
  {
    title: "Samsung Tizen & LG webOS Smart TV",
    sub: "Install IBO Player Pro or Smart IPTV directly from your TV app store with no extra sticks.",
    img: "/images/packimages2/Gemini_Generated_Image_t9inzdt9inzdt9in.jpg",
    badge: "Direct TV App",
    speed: "Instant Sync"
  },
  {
    title: "PC, MacBook & Web Browser Player",
    sub: "Watch anywhere via VLC, IPTV Smarters Desktop, or instant Xtream Codes Web Player.",
    img: "/images/packimages2/Gemini_Generated_Image_vqwd0ovqwd0ovqwd.jpg",
    badge: "Work & Travel",
    speed: "Zero Install"
  }
];

// Real Device Hardware List with Local Image Paths
const supportedDevices = [
  { name: "Amazon Firestick", sub: "4K Max / Cube / Lite", img: "/images/firestick.png", badge: "Most Popular" },
  { name: "Samsung Smart TV", sub: "Tizen OS (2016-2026)", img: "/images/samsungsmarttv.png", badge: "Smart TV" },
  { name: "LG Smart TV", sub: "webOS 3.0 to 24", img: "/images/LG TV (webOS).png", badge: "webOS" },
  { name: "Apple TV 4K", sub: "tvOS / iOS / iPadOS", img: "/images/appletv.png", badge: "Apple 4K" },
  { name: "Android TV Box", sub: "Google TV / Android 9-14", img: "/images/androidtvbox.png", badge: "Android" },
  { name: "Nvidia Shield TV", sub: "Shield Pro 4K AI Upscaling", img: "/images/nvidiashield.png", badge: "High End" },
  { name: "Formuler Z11", sub: "MyTVOnline 3 Hardware", img: "/images/Formuler.png", badge: "Dedicated" },
  { name: "MAG Boxes", sub: "MAG 524 / 540 / Stalker", img: "/images/mag.png", badge: "MAG" },
  { name: "Windows PC & Laptop", sub: "Windows 10 / 11 / VLC", img: "/images/windowspc.png", badge: "PC" },
  { name: "Apple Mac & MacBook", sub: "macOS Sequoia / M1-M4", img: "/images/macos.png", badge: "macOS" },
  { name: "iPhone & iPad", sub: "iOS 15-18 / GSE / Smarters", img: "/images/iphone17.png", badge: "iOS" },
  { name: "Android Phones", sub: "Samsung, Pixel, Xiaomi", img: "/images/androidphones.png", badge: "Mobile" },
  { name: "Sony Google TV", sub: "Bravia XR 4K HDR", img: "/images/Sony TV (Google TV).png", badge: "Sony" },
  { name: "Hisense TV", sub: "VIDAA / Android TV", img: "/images/Hisense TV.png", badge: "Hisense" },
  { name: "TCL TV", sub: "Google TV / Roku TV", img: "/images/TCL TV.png", badge: "TCL" },
  { name: "Google Chromecast", sub: "Chromecast with Google TV", img: "/images/chromecast.png", badge: "Google" },
  { name: "Roku Streaming", sub: "Roku Express / Ultra / Stick", img: "/images/roku.png", badge: "Roku" },
  { name: "Microsoft Xbox", sub: "Xbox Series X / S & One", img: "/images/Xbox.png", badge: "Console" },
  { name: "Sony PlayStation", sub: "PlayStation 5 & 4", img: "/images/PlayStation.png", badge: "Console" }
];

// Real IPTV Player App Logos
const playerApps = [
  { name: "TiviMate Premium", type: "Android / Firestick", img: "/images/Tivimate-app-logo.webp", rating: "4.9/5", top: true },
  { name: "IBO Player Pro", type: "Samsung, LG, Fire TV", img: "/images/Ibo-Player-Pro-app-logo.webp", rating: "4.8/5", top: true },
  { name: "Hot Player", type: "Smart TVs & Mobile", img: "/images/Hot-Player-app-logo.webp", rating: "4.7/5", top: false },
  { name: "Smart IPTV (SIPTV)", type: "LG, Samsung, Android", img: "/images/Smart-IPTV-app-logo.webp", rating: "4.6/5", top: false },
  { name: "Smart STB", type: "MAG Portal Emulation", img: "/images/Smart-STB-app-logo.webp", rating: "4.6/5", top: false }
];
---

<section class="setup-section" id="setup">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-badge"><i class="fa-solid fa-download"></i> Universal Compatibility</span>
      <h2 class="section-title">Compatible with <span class="gradient-text">All Devices &amp; Players</span> (2026)</h2>
      <p class="section-description">
        Our high-speed streams work seamlessly across all streaming sticks, Smart TVs, mobile phones, tablets, PCs, and gaming consoles. Setup takes under {setupTime} with our instant Xtream Codes API and M3U playlists.
      </p>
    </div>

    <!-- Real Photography Hardware Spotlight Grid -->
    <div class="hardware-spotlight-grid">
      {hardwareSpotlights.map((item) => (
        <div class="spotlight-card glass-card">
          <div class="spotlight-img-wrap">
            <img src={item.img} alt={item.title} class="spotlight-img" loading="lazy" />
            <span class="spotlight-badge">{item.badge}</span>
            <span class="spotlight-speed"><i class="fa-solid fa-bolt text-warning"></i> {item.speed}</span>
          </div>
          <div class="spotlight-body">
            <h4>{item.title}</h4>
            <p>{item.sub}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- 3-Step Setup Process Cards -->
    <div class="setup-steps-grid">
      <div class="step-card glass-card">
        <div class="step-badge">Step 01</div>
        <div class="step-icon-wrap"><i class="fa-solid fa-cart-shopping"></i></div>
        <h3>Select Plan &amp; Receive Details</h3>
        <p>
          Choose your plan and receive your automated Xtream Codes login credentials (Server URL, Username, Password) and M3U playlist URL instantly via WhatsApp and Email.
        </p>
      </div>

      <div class="step-card glass-card">
        <div class="step-badge">Step 02</div>
        <div class="step-icon-wrap"><i class="fa-solid fa-mobile-screen-button"></i></div>
        <h3>Download Recommended Player App</h3>
        <p>
          Install <strong>TiviMate</strong>, <strong>IPTV Smarters Pro</strong>, or <strong>IBO Player</strong> from your device app store or using Downloader application code.
        </p>
      </div>

      <div class="step-card glass-card">
        <div class="step-badge">Step 03</div>
        <div class="step-icon-wrap"><i class="fa-solid fa-play"></i></div>
        <h3>Enter Credentials &amp; Enjoy 4K</h3>
        <p>
          Enter the server URL, username, and password. All 51,000+ live channels, sports schedules, and 200,000+ VOD movies will synchronize automatically in seconds.
        </p>
      </div>
    </div>

    <!-- Top IPTV Player Apps Strip -->
    <div class="player-apps-container glass-card">
      <div class="apps-header">
        <div class="apps-header-left">
          <i class="fa-solid fa-tv apps-header-icon"></i>
          <div>
            <h3>Recommended IPTV Player Applications</h3>
            <p>Optimized for fast channel switching, 60FPS sports playback, and 7-day EPG guides</p>
          </div>
        </div>
        <span class="apps-count-badge">5 Verified Players</span>
      </div>

      <div class="player-apps-grid">
        {playerApps.map((app) => (
          <div class={`app-card ${app.top ? 'app-top' : ''}`}>
            <div class="app-logo-wrap">
              <img src={app.img} alt={app.name} class="app-logo-img" loading="lazy" />
            </div>
            <div class="app-info">
              <h4>{app.name}</h4>
              <span class="app-type">{app.type}</span>
              <div class="app-rating">
                <i class="fa-solid fa-star"></i> <span>{app.rating}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Full Hardware Compatibility Grid with Real Photos -->
    <div class="hardware-grid-container glass-card">
      <div class="hardware-header">
        <div class="hardware-header-left">
          <i class="fa-solid fa-microchip hardware-header-icon"></i>
          <div>
            <h3>Supported Hardware &amp; Streaming Devices</h3>
            <p>Plug and play support for over 19+ certified streaming devices and operating systems</p>
          </div>
        </div>
        <span class="hardware-badge">100% Tested</span>
      </div>

      <div class="hardware-grid">
        {supportedDevices.map((dev) => (
          <div class="dev-card">
            <div class="dev-img-wrap">
              <img src={dev.img} alt={dev.name} class="dev-img" loading="lazy" />
            </div>
            <div class="dev-details">
              <span class="dev-badge">{dev.badge}</span>
              <h4>{dev.name}</h4>
              <p>{dev.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Technical Setup Blueprint Box -->
    <div class="technical-blueprint glass-card">
      <div class="blueprint-header">
        <div class="blueprint-badge">CONFIGURATION DETAILS</div>
        <h3>Xtream Codes API &amp; M3U Playlist Architecture</h3>
      </div>

      <div class="blueprint-grid">
        <div class="bp-item">
          <span class="bp-label">Xtream Server URL</span>
          <code>http://line.streamb4.com:8080</code>
        </div>
        <div class="bp-item">
          <span class="bp-label">Username / Password</span>
          <code>Delivered instantly upon checkout (3-Min SLA)</code>
        </div>
        <div class="bp-item">
          <span class="bp-label">Video Encoding Output</span>
          <code>MPEG-TS / HLS (H.264 &amp; H.265 HEVC 4K 60FPS)</code>
        </div>
        <div class="bp-item">
          <span class="bp-label">XMLTV EPG Guide URL</span>
          <code>http://line.streamb4.com:8080/xmltv.php</code>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .setup-section {
    padding: 85px 0;
  }

  /* Hardware Real Photography Spotlight */
  .hardware-spotlight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
    gap: 22px;
    margin-bottom: 36px;
  }

  .spotlight-card {
    background: rgba(13, 20, 38, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .spotlight-card:hover {
    transform: translateY(-5px);
    border-color: rgba(59, 130, 246, 0.45);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
  }

  .spotlight-img-wrap {
    position: relative;
    width: 100%;
    height: 175px;
    overflow: hidden;
    background: #000000;
  }

  .spotlight-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
  }

  .spotlight-card:hover .spotlight-img {
    transform: scale(1.06);
  }

  .spotlight-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(7, 10, 20, 0.88);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(59, 130, 246, 0.4);
    color: #38bdf8;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .spotlight-speed {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: #fbbf24;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .spotlight-body {
    padding: 18px 20px;
  }

  .spotlight-body h4 {
    font-size: 1.02rem;
    color: #ffffff;
    font-weight: 800;
    margin-bottom: 6px;
  }

  .spotlight-body p {
    font-size: 0.84rem;
    color: #94a3b8;
    line-height: 1.5;
  }

  .setup-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  .step-card {
    background: rgba(13, 20, 38, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 30px 24px;
    position: relative;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .step-card:hover {
    transform: translateY(-5px);
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  .step-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: 0.75rem;
    font-weight: 800;
    color: #38bdf8;
    background: rgba(59, 130, 246, 0.15);
    padding: 3px 10px;
    border-radius: 9999px;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .step-icon-wrap {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #2563eb 0%, #0284c7 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 1.25rem;
    margin-bottom: 18px;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
  }

  .step-card h3 {
    font-size: 1.2rem;
    color: #ffffff;
    margin-bottom: 12px;
  }

  .step-card p {
    font-size: 0.88rem;
    color: #94a3b8;
    line-height: 1.6;
  }

  /* Player Apps Strip */
  .player-apps-container {
    background: rgba(13, 20, 38, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 32px 28px;
    margin-bottom: 40px;
  }

  .apps-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .apps-header-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .apps-header-icon {
    font-size: 1.8rem;
    color: #38bdf8;
  }

  .apps-header h3 {
    font-size: 1.3rem;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .apps-header p {
    font-size: 0.88rem;
    color: #94a3b8;
  }

  .apps-count-badge {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.4);
    color: #60a5fa;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .player-apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 16px;
  }

  .app-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    transition: all 0.25s ease;
  }

  .app-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(59, 130, 246, 0.3);
    transform: translateY(-3px);
  }

  .app-card.app-top {
    border-color: rgba(59, 130, 246, 0.4);
    background: rgba(59, 130, 246, 0.08);
  }

  .app-logo-wrap {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
    background: #000;
  }

  .app-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .app-info h4 {
    font-size: 0.92rem;
    color: #ffffff;
    margin-bottom: 2px;
  }

  .app-type {
    font-size: 0.72rem;
    color: #94a3b8;
    display: block;
    margin-bottom: 4px;
  }

  .app-rating {
    font-size: 0.72rem;
    color: #fbbf24;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* Hardware Grid */
  .hardware-grid-container {
    background: rgba(13, 20, 38, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 32px 28px;
    margin-bottom: 40px;
  }

  .hardware-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hardware-header-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hardware-header-icon {
    font-size: 1.8rem;
    color: #38bdf8;
  }

  .hardware-header h3 {
    font-size: 1.3rem;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .hardware-header p {
    font-size: 0.88rem;
    color: #94a3b8;
  }

  .hardware-badge {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #34d399;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .hardware-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 14px;
  }

  .dev-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.2s ease;
  }

  .dev-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(59, 130, 246, 0.3);
    transform: translateY(-3px);
  }

  .dev-img-wrap {
    width: 60px;
    height: 60px;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dev-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .dev-badge {
    font-size: 0.65rem;
    font-weight: 700;
    color: #38bdf8;
    background: rgba(59, 130, 246, 0.12);
    padding: 2px 8px;
    border-radius: 9999px;
    margin-bottom: 6px;
    display: inline-block;
  }

  .dev-details h4 {
    font-size: 0.88rem;
    color: #ffffff;
    margin-bottom: 2px;
  }

  .dev-details p {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  /* Technical Blueprint */
  .technical-blueprint {
    background: rgba(8, 14, 28, 0.95);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 16px;
    padding: 24px 28px;
  }

  .blueprint-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .blueprint-badge {
    background: rgba(59, 130, 246, 0.2);
    color: #38bdf8;
    border: 1px solid rgba(59, 130, 246, 0.4);
    font-size: 0.7rem;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 6px;
    letter-spacing: 0.5px;
  }

  .blueprint-header h3 {
    font-size: 1.15rem;
    color: #ffffff;
  }

  .blueprint-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px;
  }

  .bp-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 12px 16px;
  }

  .bp-label {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: 6px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .bp-item code {
    font-family: monospace;
    font-size: 0.82rem;
    color: #38bdf8;
    word-break: break-all;
  }

  @media (max-width: 600px) {
    .hardware-spotlight-grid {
      grid-template-columns: 1fr;
    }
    .hardware-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
