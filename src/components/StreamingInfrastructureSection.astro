---
import siteConfig from '../data/site-config.json';

// Technical Architecture & Live Streaming Proof Section
const techFeatures = [
  {
    title: "10Gbps Dedicated Edge Servers",
    desc: "Redundant edge clusters in London, Manchester, New York, Dallas, and Frankfurt ensuring 99.99% uptime with 8ms ping.",
    img: "/images/packimages2/Gemini_Generated_Image_68n0o968n0o968n0.jpg",
    badge: "10Gbps Network"
  },
  {
    title: "Anti-Freeze v9.2 Protocol",
    desc: "Proprietary intelligent packet-routing eliminates frame drops and buffer lag during peak live Premier League & NFL games.",
    img: "/images/packimages2/Gemini_Generated_Image_932c5932c5932c59.jpg",
    badge: "Zero Buffering"
  },
  {
    title: "True 4K UHD & 60FPS Engine",
    desc: "Uncompressed HEVC/H.265 video encoding at 35 Mbps for cinema-grade clarity and razor-sharp sports motion.",
    img: "/images/packimages2/Gemini_Generated_Image_22ozpx22ozpx22oz.jpg",
    badge: "4K 60FPS"
  },
  {
    title: "SSL Tunneling & ISP Protection",
    desc: "Military-grade encryption bypasses aggressive UK & US ISP throttling (Sky, BT, Virgin, Comcast) without requiring slow VPNs.",
    img: "/images/packimages2/Gemini_Generated_Image_4jviup4jviup4jvi.jpg",
    badge: "ISP Unblock"
  },
  {
    title: "200,000+ VOD Cinema Library",
    desc: "Daily updated Netflix, Disney+, HBO Max, Apple TV+, and Amazon Prime releases with multi-language subtitles.",
    img: "/images/packimages2/photo_2025-08-23_12-37-32_cleanup.webp",
    badge: "Cinema VOD"
  },
  {
    title: "24/7 Dedicated Support Team",
    desc: "Live WhatsApp engineers and ticketing desk ready to assist with device activation, playlist syncing, and renewal management.",
    img: "/images/packimages2/Gemini_Generated_Image_ajzn75ajzn75ajzn.jpg",
    badge: "24/7 Live Desk"
  }
];
---

<!-- ==================== STREAMING INFRASTRUCTURE SECTION ==================== -->
<section class="tech-infra-section section-padding-lg" id="infrastructure">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-badge"><i class="fa-solid fa-server"></i> Server Architecture &amp; Technology</span>
      <h2 class="section-title">Built on High-Performance <span class="gradient-text">10Gbps Cloud Infrastructure</span></h2>
      <p class="section-description">
        Engineered for zero-buffering live sports and ultra-crisp 4K streaming. Discover how our proprietary broadcasting backbone outmatches standard IPTV providers.
      </p>
    </div>

    <!-- Tech Grid with Real High-Res Photos -->
    <div class="tech-grid">
      {techFeatures.map((t) => (
        <div class="tech-card glass-card">
          <div class="tech-img-wrap">
            <img src={t.img} alt={t.title} class="tech-img" loading="lazy" />
            <span class="tech-badge">{t.badge}</span>
          </div>
          <div class="tech-card-body">
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Infographic Banner: IPTV vs Traditional Cable with Cord-Cutting Visual -->
    <div class="infra-banner glass-card">
      <div class="infra-banner-content">
        <span class="banner-badge"><i class="fa-solid fa-bolt"></i> Cord-Cutting Revolution</span>
        <h3>Why Switch from Cable &amp; Satellite to IPTV in 2026?</h3>
        <p>
          Traditional cable contracts in the USA and UK cost between $120 to £95 per month with hidden equipment rental fees and locked sports packages. <strong>{siteConfig.siteName}</strong> delivers 10x more content at 90% lower cost with complete multi-device freedom.
        </p>
        <div class="banner-stats">
          <div class="b-stat">
            <strong>Save $1,400+ / yr</strong>
            <span>Compared to Cable</span>
          </div>
          <div class="b-stat">
            <strong>{siteConfig.claims?.channelsCount || siteConfig.stats?.channels || "51,000+"}</strong>
            <span>Worldwide Coverage</span>
          </div>
          <div class="b-stat">
            <strong>5 Simultaneous</strong>
            <span>Device Connections</span>
          </div>
        </div>
        <div class="banner-cta">
          <a href="/iptv-free-trial" class="btn btn-primary btn-lg pulse-animation">
            <i class="fa-solid fa-play"></i> Start 24H Free Test
          </a>
          <a href="/#pricing" class="btn btn-secondary btn-lg">
            <i class="fa-solid fa-tags"></i> Compare All Pricing
          </a>
        </div>
      </div>
      <div class="infra-banner-img-wrap">
        <img 
          src="/images/packimages2/Gemini_Generated_Image_40x4xd40x4xd40x4.jpg" 
          alt="Cut the Cable Cord with High Speed IPTV in 2026" 
          class="banner-img" 
          loading="lazy" 
        />
        <div class="banner-img-badge">
          <i class="fa-solid fa-scissors text-warning"></i>
          <span>Say Goodbye to $150/mo Cable Bills</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .tech-infra-section {
    padding: 85px 0;
    background: rgba(8, 12, 24, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 26px;
    margin-bottom: 50px;
  }

  .tech-card {
    background: rgba(13, 20, 38, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .tech-card:hover {
    transform: translateY(-6px);
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
  }

  .tech-img-wrap {
    position: relative;
    width: 100%;
    height: 190px;
    overflow: hidden;
    background: #000000;
  }

  .tech-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .tech-card:hover .tech-img {
    transform: scale(1.06);
  }

  .tech-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(7, 10, 20, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(59, 130, 246, 0.35);
    color: #38bdf8;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .tech-card-body {
    padding: 22px;
  }

  .tech-card-body h3 {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 8px;
    font-weight: 700;
  }

  .tech-card-body p {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.55;
  }

  /* Infra Banner */
  .infra-banner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 36px;
    align-items: center;
    background: linear-gradient(135deg, rgba(17, 26, 52, 0.9) 0%, rgba(10, 16, 32, 0.95) 100%);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 20px;
    padding: 36px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }

  .banner-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: #fbbf24;
    padding: 4px 12px;
    border-radius: 9999px;
    font-size: 0.76rem;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .infra-banner-content h3 {
    font-size: 1.6rem;
    color: #ffffff;
    margin-bottom: 12px;
    font-weight: 800;
  }

  .infra-banner-content p {
    font-size: 0.92rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin-bottom: 22px;
  }

  .banner-stats {
    display: flex;
    gap: 20px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .b-stat {
    display: flex;
    flex-direction: column;
  }

  .b-stat strong {
    font-size: 1.2rem;
    color: #38bdf8;
    font-weight: 800;
  }

  .b-stat span {
    font-size: 0.74rem;
    color: #94a3b8;
  }

  .banner-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .infra-banner-img-wrap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    height: 270px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .banner-img-badge {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: rgba(7, 10, 20, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media (max-width: 992px) {
    .infra-banner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .infra-banner {
      padding: 24px 18px;
    }
    .infra-banner-img-wrap {
      height: 200px;
    }
    .banner-cta {
      flex-direction: column;
    }
    .banner-cta .btn {
      width: 100%;
    }
  }
</style>
