<script>
  // Mobile drawer
  const btn = document.getElementById('mobileMenuBtn');
  const closeBtn = document.getElementById('mobileMenuClose');
  const overlay = document.getElementById('mobileMenuOverlay');

  function setMenu(open: boolean) {
    if (!overlay) return;
    overlay.classList.toggle('active', open);
    document.body.style.overflow = open ? 'hidden' : '';
    btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  if (btn && overlay && closeBtn) {
    btn.setAttribute('aria-expanded', 'false');
    btn.addEventListener('click', () => setMenu(true));
    closeBtn.addEventListener('click', () => setMenu(false));

    // Tap on the dark area outside the drawer
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) setMenu(false);
    });

    // Tap on any link inside the drawer: close it first, then let the browser follow the link.
    // (Same-page anchors such as /#providers do not reload the page, so without this the drawer stayed open.)
    overlay.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a');
      if (link) setMenu(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setMenu(false);
    });

    // Going back/forward or changing hash must never leave the page locked
    window.addEventListener('hashchange', () => setMenu(false));
    window.addEventListener('pageshow', () => setMenu(false));

    // Rotating the phone / resizing to desktop width closes the drawer
    window.matchMedia('(min-width: 1381px)').addEventListener('change', (m) => {
      if (m.matches) setMenu(false);
    });
  }
</script>

