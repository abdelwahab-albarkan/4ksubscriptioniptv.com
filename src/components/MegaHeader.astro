---
import siteConfig from '../data/site-config.json';

const regions = [
  { code: 'US', href: '/', flag: 'us', name: 'United States', cur: 'USD $' },
  { code: 'UK', href: '/uk', flag: 'gb', name: 'United Kingdom', cur: 'GBP £' },
  { code: 'DE', href: '/de', flag: 'de', name: 'Deutschland', cur: 'EUR €' },
  { code: 'FR', href: '/fr', flag: 'fr', name: 'France', cur: 'EUR €' },
  { code: 'ES', href: '/es', flag: 'es', name: 'España', cur: 'EUR €' },
];
const pathNow = Astro.url.pathname;
const currentRegion =
  regions.find((r) => r.href !== '/' && (pathNow === r.href || pathNow.startsWith(r.href + '/'))) || regions[0];
