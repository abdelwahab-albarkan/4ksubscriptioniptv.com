---
// Comparison Matrix Component
---

<section class="comparison-section">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">Why Choose Us</span>
      <h2 class="section-title">4KSubscriptionIPTV vs <span class="gradient-text">Traditional Cable &amp; Other IPTVs</span></h2>
      <p class="section-desc">
        Save over 90% every year without compromising on channel quality, sports blackouts, or server reliability.
      </p>
    </div>

    <div class="comparison-table-wrap glass-card">
      <table class="comparison-table">
        <thead>
          <tr>
            <th class="col-feature">Feature / Benefit</th>
            <th class="col-us highlight-col">
              <span class="brand-tag">RECOMMENDED</span>
              <strong>4KSubscriptionIPTV Premium</strong>
            </th>
            <th class="col-cable">Traditional Cable &amp; Sky TV</th>
            <th class="col-cheap">Cheap / Free IPTV Servers</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="col-feature">
              <strong>Monthly Cost</strong>
              <span>Annual estimated expenditure</span>
            </td>
            <td class="col-us highlight-col">
              <span class="price-val gradient-green">$5 - $12 / mo</span>
              <span class="price-sub">Save $1,500+ every year</span>
            </td>
            <td class="col-cable">
              <span class="bad-price">$120 - $180 / mo</span>
              <span class="price-sub">Excessive fees &amp; hidden charges</span>
            </td>
            <td class="col-cheap">
              <span>$3 - $6 / mo</span>
              <span class="price-sub">Unreliable / Frequent shutdowns</span>
            </td>
          </tr>

          <tr>
            <td class="col-feature">
              <strong>Live Channel Count</strong>
              <span>Global coverage across 100+ nations</span>
            </td>
            <td class="col-us highlight-col">
              <span class="good-val">✅ 51,000+ Channels</span>
            </td>
            <td class="col-cable">
              <span>❌ 150 - 300 Channels</span>
            </td>
            <td class="col-cheap">
              <span>⚠️ 5,000 (Many Dead Links)</span>
            </td>
          </tr>

          <tr>
            <td class="col-feature">
              <strong>Premier League &amp; US Sports</strong>
              <span>3PM Blackouts, NFL Sunday Ticket, UFC</span>
            </td>
            <td class="col-us highlight-col">
              <span class="good-val">✅ 100% All Sports Included</span>
            </td>
            <td class="col-cable">
              <span>❌ Blackout restrictions apply</span>
            </td>
            <td class="col-cheap">
              <span>⚠️ Freezes during big games</span>
            </td>
          </tr>

          <tr>
            <td class="col-feature">
              <strong>Stream Quality &amp; Bitrate</strong>
              <span>True 4K UHD, FHD &amp; 60FPS</span>
            </td>
            <td class="col-us highlight-col">
              <span class="good-val">✅ True 4K UHD 60FPS</span>
            </td>
            <td class="col-cable">
              <span>⚠️ 1080i / Standard HD</span>
            </td>
            <td class="col-cheap">
              <span>❌ Heavily compressed 720p</span>
            </td>
          </tr>

          <tr>
            <td class="col-feature">
              <strong>Anti-Freeze Server Guarantee</strong>
              <span>Private high-bandwidth CDN network</span>
            </td>
            <td class="col-us highlight-col">
              <span class="good-val">✅ Anti-Freeze v9.2 (99.99% SLA)</span>
            </td>
            <td class="col-cable">
              <span>✅ Good reliability</span>
            </td>
            <td class="col-cheap">
              <span>❌ Constant buffering &amp; crashes</span>
            </td>
          </tr>

          <tr>
            <td class="col-feature">
              <strong>Contract &amp; Hardware Lock-in</strong>
              <span>Flexible cancel anytime terms</span>
            </td>
            <td class="col-us highlight-col">
              <span class="good-val">✅ No Contract (Cancel Anytime)</span>
            </td>
            <td class="col-cable">
              <span>❌ 18 to 24-Month Lock-in</span>
            </td>
            <td class="col-cheap">
              <span>✅ No contract</span>
            </td>
          </tr>

          <tr>
            <td class="col-feature">
              <strong>Free 24H Trial &amp; Refund SLA</strong>
              <span>Risk-free test period</span>
            </td>
            <td class="col-us highlight-col">
              <span class="good-val">✅ 24H Trial + 7-Day Money Back</span>
            </td>
            <td class="col-cable">
              <span>❌ High cancellation penalties</span>
            </td>
            <td class="col-cheap">
              <span>❌ No support / No refund</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .comparison-section {
    padding: 70px 0;
  }

  .comparison-table-wrap {
    overflow-x: auto;
    padding: 0;
    border-radius: var(--radius-md);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 700px;
  }

  .comparison-table th, .comparison-table td {
    padding: 20px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    vertical-align: middle;
  }

  .comparison-table th {
    background: rgba(13, 19, 36, 0.9);
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: #ffffff;
  }

  .col-feature {
    width: 32%;
  }

  .col-feature strong {
    display: block;
    font-size: 0.95rem;
    color: #ffffff;
  }

  .col-feature span {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .highlight-col {
    background: rgba(59, 130, 246, 0.08);
    border-left: 2px solid #3b82f6;
    border-right: 2px solid #3b82f6;
    position: relative;
  }

  .brand-tag {
    display: inline-block;
    background: #10b981;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    padding: 2px 8px;
    border-radius: 4px;
    margin-bottom: 4px;
  }

  .price-val {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    display: block;
  }

  .price-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: block;
  }

  .bad-price {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: #f87171;
    display: block;
  }

  .good-val {
    color: #34d399;
    font-weight: 700;
    font-size: 0.92rem;
  }
</style>
