---
import siteConfig from '../data/site-config.json';
import { fromUsdMo, fromGbpMo } from '../lib/pricing';

interface Props {
  h1?: string;
  targetKeyword?: string;
  country?: string;
  locationName?: string;
  deviceName?: string;
  sportName?: string;
  priceUsd?: string;
  priceGbp?: string;
  discountPercentage?: string;
  serverPing?: string;
  rating?: string;
  reviewCount?: string;
  heroImage?: string;
}

const {
  h1 = "Launch Your IPTV Reseller Empire & Premium 8K/4K Streaming in 2026",
  targetKeyword = "IPTV Reseller Panel & Premium Providers",
  country = "USA & UK",
  locationName,
  deviceName,
  sportName,
  priceUsd = fromUsdMo,
  priceGbp = fromGbpMo,
  discountPercentage = "50% OFF",
  serverPing = "8ms (10Gbps London & US East Nodes)",
  rating = "4.95",
  reviewCount = "14,820",
  heroImage
} = Astro.props;

const isUkContext = country.toLowerCase().includes('uk') || country.toLowerCase().includes('kingdom') || (locationName && ['london', 'manchester', 'birmingham', 'glasgow', 'liverpool', 'leeds', 'sheffield', 'bristol', 'edinburgh'].includes(locationName.toLowerCase()));

// Smart contextual hero photography selection
let selectedHeroImg = heroImage;
if (!selectedHeroImg) {
  const tKw = (targetKeyword || '').toLowerCase();
  const sNm = (sportName || '').toLowerCase();
  const dNm = (deviceName || '').toLowerCase();
  const h1Lower = (h1 || '').toLowerCase();
  const combinedContext = `${tKw} ${sNm} ${dNm} ${h1Lower}`;

  if (combinedContext.includes('premier league') || combinedContext.includes('football') || combinedContext.includes('soccer') || combinedContext.includes('tnt sports') || combinedContext.includes('champions league') || combinedContext.includes('sky sports')) {
    selectedHeroImg = "/images/packimages2/lucid-origin_Dramatic_wide_night_photo_of_a_packed_football_stadium_floodlights_green_pitch_p-0.jpg";
  } else if (combinedContext.includes('nfl') || combinedContext.includes('super bowl') || combinedContext.includes('american football')) {
    selectedHeroImg = "/images/packimages2/lucid-origin_American_football_stadium_at_night_quarterback_about_to_throw_linemen_in_motion_-0.jpg";
  } else if (combinedContext.includes('nba') || combinedContext.includes('basketball')) {
    selectedHeroImg = "/images/packimages2/lucid-origin_Basketball_arena_a_player_in_generic_plain_jersey_dunking_dramatic_spotlights_a_-0.jpg";
  } else if (combinedContext.includes('ufc') || combinedContext.includes('boxing') || combinedContext.includes('ppv') || combinedContext.includes('dazn') || combinedContext.includes('fight') || combinedContext.includes('mma')) {
    selectedHeroImg = "/images/packimages2/lucid-origin_Fighter_in_a_boxing_ring_seen_from_behind_glove_raised_arena_lights_and_smoke_cr-0.jpg";
  } else if (combinedContext.includes('f1') || combinedContext.includes('formula') || combinedContext.includes('grand prix') || combinedContext.includes('nascar') || combinedContext.includes('motogp')) {
    selectedHeroImg = "/images/packimages2/lucid-origin_Formula-style_open-wheel_racing_car_at_night_on_a_city_circuit_motion_blur_neon_-0.jpg";
  } else if (combinedContext.includes('cricket') || combinedContext.includes('ashes') || combinedContext.includes('ipl')) {
    selectedHeroImg = "/images/packimages2/cricket-iptv-australia-sports.webp";
  } else if (combinedContext.includes('firestick') || combinedContext.includes('fire tv') || combinedContext.includes('amazon fire')) {
    selectedHeroImg = "/images/packimages2/Gemini_Generated_Image_fjow55fjow55fjow.jpg";
  } else if (combinedContext.includes('smart tv') || combinedContext.includes('samsung') || combinedContext.includes('lg tv') || combinedContext.includes('sony tv')) {
    selectedHeroImg = "/images/packimages2/Gemini_Generated_Image_t9inzdt9inzdt9in.jpg";
  } else if (combinedContext.includes('apple tv') || combinedContext.includes('android box') || combinedContext.includes('nvidia shield') || combinedContext.includes('formuler') || combinedContext.includes('mag box')) {
    selectedHeroImg = "/images/packimages2/Gemini_Generated_Image_razn6trazn6trazn.jpg";
  } else if (combinedContext.includes('pc') || combinedContext.includes('windows') || combinedContext.includes('mac') || combinedContext.includes('laptop') || combinedContext.includes('vlc')) {
    selectedHeroImg = "/images/packimages2/Gemini_Generated_Image_vqwd0ovqwd0ovqwd.jpg";
  } else if (combinedContext.includes('movie') || combinedContext.includes('vod') || combinedContext.includes('cinema') || combinedContext.includes('netflix') || combinedContext.includes('series')) {
    selectedHeroImg = "/images/packimages2/photo_2025-08-23_12-37-32_cleanup.webp";
  } else if (isUkContext) {
    selectedHeroImg = "/images/packimages2/lucid-origin_Photorealistic_cozy_British_living_room_rainy_evening_visible_through_the_window-0.jpg";
  } else {
    selectedHeroImg = "/images/packimages2/lucid-origin_Photorealistic_wide_shot_of_a_modern_living_room_at_night_with_a_large_65-inch_4-0.jpg";
  }
}
---

<!-- ==================== HERO SECTION ==================== -->
<section class="hero-section hero-full">
  <div class="hero-background">
    <div class="gradient-orb gradient-orb-1"></div>
    <div class="gradient-orb gradient-orb-2"></div>
    <div class="gradient-orb gradient-orb-3"></div>
    <div class="hero-grid-pattern"></div>
  </div>

  <div class="container">
    <div class="hero-grid">
      <!-- Left Content -->
      <div class="hero-content">
        <div class="hero-badge-wrap">
          <span class="section-badge pulse-badge">
            <i class="fa-solid fa-bolt-lightning"></i> Enterprise 4K Streaming &amp; Reseller Infrastructure
          </span>
          <span class="section-badge trust-badge">
            <i class="fa-solid fa-shield-halved"></i> 99.99% Uptime SLA &bull; 64,000+ Active Streamers
          </span>
        </div>

        <h1 class="hero-title">
          {h1}
        </h1>

        <p class="hero-description">
          <strong>{siteConfig.siteName}</strong> provides direct access to dedicated <strong>10Gbps load-balanced streaming clusters</strong> and wholesale IPTV reseller panels. Stream over <strong>{siteConfig.claims?.channelsCount || siteConfig.stats?.channels || "51,000+"} live 4K/60FPS channels</strong>, all major sports (Premier League, NFL Sunday Ticket, Champions League, UFC PPVs), and <strong>{siteConfig.claims?.vodCount || siteConfig.stats?.totalVod || "200,000+"} on-demand movies</strong> with our proprietary Anti-Freeze Protocol v9.2. Instant 3-minute delivery with zero long-term contracts.
        </p>

        <div class="hero-actions">
          <a href="/iptv-free-trial" class="btn btn-primary btn-xl pulse-animation">
            <i class="fa-solid fa-play"></i> Get Instant 24H Free Trial
          </a>
          <a href="/#pricing" class="btn btn-secondary btn-xl">
            <i class="fa-solid fa-tags"></i> View All Plans ({priceUsd})
          </a>
          <a href={siteConfig.whatsappUrl} class="btn btn-secondary desk btn-xl" target="_blank" rel="noopener">
            <i class="fa-brands fa-whatsapp text-whatsapp"></i> WhatsApp Concierge
          </a>
        </div>

        <!-- 5 Stats Counters -->
        <div class="hero-stats">
          <div class="stat-item">
            <i class="fa-solid fa-film"></i>
            <strong>{siteConfig.claims?.vodCount || siteConfig.stats?.totalVod || "200,000+"}</strong>
            <span>4K/UHD VOD Library</span>
          </div>
          <div class="stat-item">
            <i class="fa-solid fa-tv"></i>
            <strong>{siteConfig.claims?.channelsCount || siteConfig.stats?.channels || "51,000+"}</strong>
            <span>Live 60FPS Channels</span>
          </div>
          <div class="stat-item">
            <i class="fa-solid fa-network-wired"></i>
            <strong>12 Nodes</strong>
            <span>Global Edge CDN</span>
          </div>
          <div class="stat-item">
            <i class="fa-solid fa-gauge-high"></i>
            <strong>8ms</strong>
            <span>Ultra-Low Latency</span>
          </div>
          <div class="stat-item">
            <i class="fa-solid fa-headset"></i>
            <strong>24/7</strong>
            <span>WhatsApp Engineer</span>
          </div>
        </div>
      </div>

      <!-- Right Visual Showcase: OLED 4K Display Mockup -->
      <div class="hero-visual">
        <div class="tv-showcase-container">
          
          <!-- Ambient Glow Effect -->
          <div class="tv-ambient-glow"></div>

          <!-- TV Frame Mockup -->
          <div class="tv-device-frame">
            
            <!-- Screen Top Status Bar -->
            <div class="tv-status-bar">
              <div class="status-left">
                <span class="live-pill"><span class="blinking-dot"></span> LIVE 4K 60FPS</span>
                <span class="protocol-tag"><i class="fa-solid fa-shield"></i> Anti-Freeze v9.2</span>
              </div>
              <div class="status-right">
                <span class="audio-badge"><i class="fa-solid fa-volume-high"></i> Dolby 5.1</span>
                <span class="ping-badge"><i class="fa-solid fa-wifi"></i> 8ms</span>
              </div>
            </div>

            <!-- Screen Image -->
            <div class="tv-screen-wrapper">
              <img 
                src={selectedHeroImg} 
                alt={`${targetKeyword} 4K UHD Live Stream Setup`} 
                class="tv-screen-img" 
                loading="eager" 
                fetchpriority="high"
              />
              <div class="tv-screen-reflection"></div>
              
              <!-- Floating Pill Overlay: Active Program -->
              <div class="floating-channel-badge">
                <div class="channel-logo-dot"><i class="fa-solid fa-satellite-dish"></i></div>
                <div class="channel-info-text">
                  <span class="channel-sub">Now Streaming 4K UHD</span>
                  <span class="channel-main">Sky Sports &bull; TNT &bull; NFL &bull; DAZN &bull; 200k+ VOD</span>
                </div>
              </div>

              <!-- Top Floating Badge: Reseller / Subscriber Count -->
              <div class="floating-stat-badge top-stat">
                <i class="fa-solid fa-bolt text-warning"></i>
                <div>
                  <strong>51,000+ Channels</strong>
                  <small>Zero Blackout Lock</small>
                </div>
              </div>

              <!-- Bottom Floating Badge: Rating -->
              <div class="floating-stat-badge bottom-stat">
                <div class="rating-stars">
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                </div>
                <div>
                  <strong>{rating}/5.0 Verified</strong>
                  <small>{reviewCount} Active Streamers</small>
                </div>
              </div>

            </div>

            <!-- TV Bottom Bezel & Brand Logo -->
            <div class="tv-bezel-bottom">
              <span class="tv-brand-logo"><i class="fa-solid fa-play"></i> 4KSUBSCRIPTION IPTV 4K</span>
              <div class="tv-power-led"></div>
            </div>

          </div>

          <!-- Bottom Stream Features Ticker -->
          <div class="hero-live-ticker">
            <span class="ticker-item"><i class="fa-solid fa-check text-success"></i> 3-Minute Instant Delivery</span>
            <span class="ticker-item"><i class="fa-solid fa-check text-success"></i> Multi-Room 5 Screens</span>
            <span class="ticker-item"><i class="fa-solid fa-check text-success"></i> 7-Day Money-Back SLA</span>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 70px 0 60px 0;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.28;
    pointer-events: none;
  }

  .gradient-orb-1 {
    width: 500px;
    height: 500px;
    background: #3b82f6;
    top: -120px;
    left: 10%;
  }

  .gradient-orb-2 {
    width: 450px;
    height: 450px;
    background: #06b6d4;
    top: 25%;
    right: 5%;
  }

  .gradient-orb-3 {
    width: 350px;
    height: 350px;
    background: #8b5cf6;
    bottom: -60px;
    left: 35%;
  }

  .hero-grid-pattern {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 28px 28px;
    opacity: 0.35;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: 40px;
    align-items: center;
  }

  .hero-badge-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .pulse-badge {
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: #fbbf24;
  }

  .trust-badge {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.4);
    color: #60a5fa;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 4.2vw, 3.2rem);
    font-weight: 900;
    line-height: 1.12;
    color: #ffffff;
    margin-bottom: 20px;
    letter-spacing: -0.8px;
  }

  .hero-description {
    font-size: 1.05rem;
    color: #cbd5e1;
    line-height: 1.65;
    margin-bottom: 30px;
  }

  .hero-description strong {
    color: #ffffff;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .text-whatsapp {
    color: #25d366;
    font-size: 1.1rem;
  }

  /* 5 Stats */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 10px 4px;
    border-radius: 12px;
    backdrop-filter: blur(8px);
  }

  .stat-item i {
    font-size: 1.1rem;
    color: #38bdf8;
    margin-bottom: 4px;
  }

  .stat-item strong {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    color: #ffffff;
  }

  .stat-item span {
    font-size: 0.68rem;
    color: var(--text-muted);
    line-height: 1.2;
    margin-top: 2px;
  }

  /* ==================== OLED TV DISPLAY MOCKUP ==================== */
  .tv-showcase-container {
    position: relative;
    width: 100%;
  }

  .tv-ambient-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    height: 80%;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.35) 0%, rgba(6, 182, 212, 0.15) 50%, transparent 80%);
    filter: blur(50px);
    z-index: 0;
    pointer-events: none;
  }

  .tv-device-frame {
    position: relative;
    z-index: 1;
    background: #090e1c;
    border: 2px solid rgba(59, 130, 246, 0.45);
    border-radius: 20px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.75), 0 0 40px rgba(59, 130, 246, 0.25);
    padding: 10px;
    overflow: hidden;
  }

  .tv-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(5, 8, 18, 0.85);
    border-radius: 10px 10px 0 0;
    padding: 8px 14px;
    font-size: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .status-left, .status-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .live-pill {
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.5);
    color: #f87171;
    font-weight: 800;
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.5px;
  }

  .blinking-dot {
    width: 7px;
    height: 7px;
    background: #ef4444;
    border-radius: 50%;
    animation: blinkPulse 1.2s infinite;
  }

  @keyframes blinkPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.85); }
  }

  .protocol-tag, .audio-badge, .ping-badge {
    color: #94a3b8;
    font-size: 0.72rem;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .protocol-tag i { color: #38bdf8; }
  .ping-badge i { color: #10b981; }

  .tv-screen-wrapper {
    position: relative;
    width: 100%;
    height: 310px;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }

  .tv-screen-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s ease;
  }

  .tv-device-frame:hover .tv-screen-img {
    transform: scale(1.03);
  }

  .tv-screen-reflection {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.02) 40%, transparent 60%);
    pointer-events: none;
  }

  /* Floating Badges */
  .floating-stat-badge {
    position: absolute;
    background: rgba(7, 12, 26, 0.88);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 12px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    z-index: 2;
  }

  .floating-stat-badge strong {
    display: block;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .floating-stat-badge small {
    display: block;
    font-size: 0.65rem;
    color: #94a3b8;
  }

  .top-stat {
    top: 14px;
    right: 14px;
  }

  .bottom-stat {
    bottom: 14px;
    left: 14px;
  }

  .rating-stars {
    color: #fbbf24;
    font-size: 0.75rem;
    display: flex;
    gap: 1px;
  }

  .text-warning { color: #fbbf24; font-size: 1.1rem; }

  .floating-channel-badge {
    position: absolute;
    bottom: 14px;
    right: 14px;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 9999px;
    padding: 6px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 2;
  }

  .channel-logo-dot {
    width: 24px;
    height: 24px;
    background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    color: #ffffff;
  }

  .channel-info-text {
    display: flex;
    flex-direction: column;
  }

  .channel-sub {
    font-size: 0.6rem;
    text-transform: uppercase;
    color: #38bdf8;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .channel-main {
    font-size: 0.72rem;
    font-weight: 700;
    color: #f8fafc;
  }

  /* TV Bezel Bottom */
  .tv-bezel-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px 2px 12px;
  }

  .tv-brand-logo {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #64748b;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .tv-brand-logo i { color: #38bdf8; }

  .tv-power-led {
    width: 6px;
    height: 6px;
    background: #38bdf8;
    border-radius: 50%;
    box-shadow: 0 0 8px #38bdf8;
  }

  .hero-live-ticker {
    display: flex;
    justify-content: space-around;
    align-items: center;
    background: rgba(13, 20, 38, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 10px 14px;
    margin-top: 14px;
    font-size: 0.78rem;
    color: #cbd5e1;
    font-weight: 600;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .text-success { color: #10b981; }

  @media (max-width: 992px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .hero-grid { gap: 28px; }
    .hero-badge-wrap { gap: 8px; margin-bottom: 16px; }
    .section-badge { font-size: 0.72rem; padding: 4px 11px; }
    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero-stats .stat-item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .hero-actions .btn {
      width: 100%;
    }
    .hero-description {
      font-size: 0.98rem;
    }
    .tv-screen-wrapper {
      height: 220px;
    }
    .floating-stat-badge.bottom-stat {
      display: none;
    }
    .hero-live-ticker {
      flex-direction: column;
      gap: 6px;
      align-items: flex-start;
    }
  }
</style>
