---
import siteConfig from '../data/site-config.json';
---

<header class="site-header">
  <div class="top-banner">
    <div class="container top-banner-inner">
      <div class="live-indicator">
        <span class="pulse-dot"></span>
        <span><strong>Live Streams Active:</strong> 4K UHD Anti-Freeze Servers 100% Operational</span>
      </div>
      <div class="top-promo">
        <span class="flash-icon">⚡</span> 
        <span>Limited Offer: Get <strong>50% OFF</strong> + 24H Instant Activation</span>
      </div>
    </div>
  </div>

  <nav class="main-nav">
    <div class="container nav-container">
      <a href="/" class="brand-logo" id="header-logo-link">
        <div class="logo-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </div>
        <div class="brand-text">
          <span class="brand-name">4KSubscription<span class="gradient-text">IPTV</span></span>
          <span class="brand-sub">USA & UK 4K Streaming</span>
        </div>
      </a>

      <div class="nav-links">
        <a href="#pricing" class="nav-link">Pricing Plans</a>
        <a href="#channels" class="nav-link">Channels & Sports</a>
        <a href="#setup" class="nav-link">Device Setup</a>
        <a href="/all-locations" class="nav-link">US & UK Locations</a>
        <a href="#faq" class="nav-link">FAQ</a>
      </div>

      <div class="nav-actions">
        <button class="search-trigger-btn" id="open-search-btn" title="Search Locations & Devices">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span>Search 1500+ Pages</span>
        </button>

        <a href="#pricing" class="btn btn-primary nav-cta">
          <span>Get Started</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <button class="mobile-toggle" id="mobile-menu-btn" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div class="mobile-menu" id="mobile-menu-drawer">
      <a href="#pricing" class="mobile-nav-link">Pricing Plans</a>
      <a href="#channels" class="mobile-nav-link">Live Channels & Sports</a>
      <a href="#setup" class="mobile-nav-link">Device Setup Guide</a>
      <a href="/all-locations" class="mobile-nav-link">All US & UK Locations (1500+)</a>
      <a href="/all-devices" class="mobile-nav-link">Supported Devices & Apps</a>
      <a href="/all-sports" class="mobile-nav-link">Sports & PPV Guide</a>
      <a href="#faq" class="mobile-nav-link">Frequently Asked Questions</a>
      
      <div class="mobile-cta-box">
        <a href="#pricing" class="btn btn-primary" style="width: 100%;">Claim 50% Discount</a>
        <a href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp" style="width: 100%; margin-top: 10px;">
          WhatsApp 24/7 Support
        </a>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(7, 9, 19, 0.92);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border);
  }

  .top-banner {
    background: linear-gradient(90deg, #1e1b4b 0%, #0f172a 50%, #064e3b 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 6px 0;
    font-size: 0.78rem;
    color: #e2e8f0;
  }

  .top-banner-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .live-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .top-promo {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #fde047;
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 72px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo-icon {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, #2563eb 0%, #06b6d4 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    box-shadow: 0 4px 15px var(--primary-glow);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: #ffffff;
  }

  .brand-sub {
    font-size: 0.68rem;
    color: var(--text-muted);
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 600;
    color: #cbd5e1;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #38bdf8;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .search-trigger-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 8px 14px;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .search-trigger-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(59, 130, 246, 0.4);
  }

  .nav-cta {
    padding: 10px 20px;
    font-size: 0.9rem;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 20px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .mobile-toggle span {
    width: 100%;
    height: 2.5px;
    background-color: #ffffff;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #0b0f1d;
    border-bottom: 1px solid var(--border);
    padding: 24px 20px;
    flex-direction: column;
    gap: 16px;
  }

  .mobile-menu.active {
    display: flex;
  }

  .mobile-nav-link {
    font-size: 1.05rem;
    font-weight: 600;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
  }

  @media (max-width: 992px) {
    .nav-links, .nav-cta {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    .top-promo {
      display: none;
    }
  }
</style>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-menu-drawer');

  if (mobileBtn && mobileDrawer) {
    mobileBtn.addEventListener('click', () => {
      mobileDrawer.classList.toggle('active');
    });

    const links = mobileDrawer.querySelectorAll('a');
    links.forEach(l => {
      l.addEventListener('click', () => {
        mobileDrawer.classList.remove('active');
      });
    });
  }
</script>
