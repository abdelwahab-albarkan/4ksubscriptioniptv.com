---
interface RelatedPage {
  slug: string;
  title: string;
  h1?: string;
  country?: string;
}

interface Props {
  category?: string;
  relatedPages?: RelatedPage[];
}

const {
  category = "us-geo",
  relatedPages = []
} = Astro.props;
---

<section class="internal-linking-section">
  <div class="container">
    <div class="linking-box glass-card">
      <div class="linking-header">
        <span class="section-subtitle">Explore Related Guides &amp; Cities</span>
        <h3 class="linking-title">Browse More <span class="gradient-text">IPTV Streaming Coverage</span></h3>
        <p class="linking-desc">
          We provide dedicated high-speed IPTV streaming services and installation guides across all states, UK regions, and streaming devices.
        </p>
      </div>

      <!-- Related Pages Grid -->
      {relatedPages.length > 0 && (
        <div class="related-links-grid">
          {relatedPages.map((page) => (
            <a href={`/iptv/${page.slug}`} class="related-link-card">
              <span class="link-arrow">&rarr;</span>
              <span class="link-text">{page.h1 || page.title}</span>
            </a>
          ))}
        </div>
      )}

      <!-- Directory Hub Category Badges -->
      <div class="hub-categories-bar">
        <span class="hub-label">Sitemap Directories:</span>
        <a href="/all-locations" class="hub-chip">📍 All 1000+ US &amp; UK Locations</a>
        <a href="/all-devices" class="hub-chip">📱 All Device Setup Guides</a>
        <a href="/all-sports" class="hub-chip">🏆 All Sports &amp; PPV Channels</a>
        <a href="/sitemap.xml" class="hub-chip">🗺️ XML Sitemap Index</a>
      </div>
    </div>
  </div>
</section>

<style>
  .internal-linking-section {
    padding: 60px 0;
  }

  .linking-box {
    padding: 36px;
    background: rgba(13, 19, 36, 0.6);
  }

  .linking-header {
    text-align: center;
    margin-bottom: 30px;
  }

  .linking-title {
    font-size: 1.8rem;
    margin-bottom: 8px;
  }

  .linking-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .related-links-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 30px;
  }

  .related-link-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 14px 18px;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 600;
    color: #e2e8f0;
    transition: all 0.2s ease;
  }

  .related-link-card:hover {
    background: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.4);
    color: #38bdf8;
    transform: translateX(4px);
  }

  .link-arrow {
    color: #3b82f6;
    font-size: 1.1rem;
  }

  .hub-categories-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .hub-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .hub-chip {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    color: #cbd5e1;
    transition: all 0.2s;
  }

  .hub-chip:hover {
    background: #2563eb;
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .related-links-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
