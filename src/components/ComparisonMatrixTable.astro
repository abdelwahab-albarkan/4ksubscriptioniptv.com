  }
];
---

<!-- ==================== COMPARISON TABLE SECTION ==================== -->
<section class="comparison-section section-padding-lg" id="comparison-table">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-badge"><i class="fa-solid fa-scale-balanced"></i> Provider Comparison Matrix</span>
      <h2 class="section-title">What Makes a Great IPTV Reseller &amp; Streaming Provider?</h2>
      <p class="section-description">
        Not all IPTV providers are created equal. Here is the complete comparison of essential features to evaluate when choosing your IPTV provider or reseller partner for 2026.
      </p>
    </div>

    <div class="comparison-table-wrap glass-card">
      <table class="comparison-table">
        <thead>
          <tr>
            <th>Core Feature</th>
            <th>Why It Matters for Streamers &amp; Resellers</th>
            <th>Recommended Providers</th>
            <th>Impact Level</th>
          </tr>
        </thead>
        <tbody>
          {comparisonRows.map((row) => (
            <tr>
              <td>
                <strong>{row.feature}</strong>
              </td>
              <td>{row.why}</td>
              <td class="providers-cell">
                <i class="fa-solid fa-check text-success"></i> {row.providers}
              </td>
              <td>
                <span class={`impact-badge ${row.impactClass}`}>{row.impact}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .comparison-section {
    padding: 80px 0;
    background: rgba(12, 18, 36, 0.5);
  }

  .comparison-table-wrap {
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(13, 20, 38, 0.85);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 780px;
  }

  .comparison-table th {
    background: rgba(15, 23, 42, 0.95);
    color: #cbd5e1;
    font-size: 0.84rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 18px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .comparison-table td {
    padding: 18px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.88rem;
    color: #cbd5e1;
    vertical-align: middle;
  }

  .comparison-table tr:hover td {
    background: rgba(255, 255, 255, 0.03);
  }

  .comparison-table td strong {
    color: #ffffff;
    font-size: 0.92rem;
  }

  .providers-cell {
    color: #38bdf8 !important;
    font-weight: 600;
  }

  .providers-cell i {
    color: #10b981;
    margin-right: 4px;
  }

  .impact-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 9999px;
    display: inline-block;
  }

  .badge-critical {
    background: rgba(244, 63, 94, 0.2);
    color: #f43f5e;
    border: 1px solid rgba(244, 63, 94, 0.4);
  }

  .badge-high {
    background: rgba(245, 158, 11, 0.2);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.4);
  }

  .badge-medium {
    background: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.4);
  }
</style>
