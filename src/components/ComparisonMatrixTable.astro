---
const comparisonRows = [
  {
    feature: "Stable IPTV Reseller Panel",
    why: "Essential for generating customer credentials, renewals, sub-resellers, and managing trials without server downtime.",
    providers: "StreamB4, UK Stream 4K, Ultra 8K IPTV, Agency Fluxly",
    impact: "Critical",
    impactClass: "badge-critical"
  },
  {
    feature: "20,000+ Movies & Series VOD",
    why: "Massive regularly-updated 4K movie & TV series library increases customer retention and recurring subscription value.",
    providers: "StreamB4, Ultra 8K IPTV, Tvnado 2026, IPTV Smarters FR",
    impact: "High",
    impactClass: "badge-high"
  },
  {
    feature: "8,000+ to 51,000+ Live Channels",
    why: "Unrestricted access to worldwide sports (Premier League, NFL, UFC, Champions League, F1) and local network feeds.",
    providers: "StreamB4 (#1 51K), Ultra 8K, UK Stream 4K",
    impact: "High",
    impactClass: "badge-high"
  },
  {
    feature: "Multi-Device Compatibility",
    why: "Customers demand seamless streaming across Firestick 4K, Android TV, Samsung/LG Smart TVs, Apple TV, MAG & PC.",
    providers: "All 14 Listed Networks (Xtream & M3U)",
    impact: "Critical",
    impactClass: "badge-critical"
  },
  {
    feature: "24/7 Fast Dedicated Support",
    why: "Immediate technical resolution directly impacts your customer satisfaction and monthly renewal rates.",
    providers: "StreamB4, UK Stream 4K, Ultra 8K, Agency Fluxly",
    impact: "Critical",
    impactClass: "badge-critical"
  },
  {
    feature: "Anti-Freeze v9.2 Protocol",
    why: "Eliminates buffering and packet drops during peak global sports events through redundant 10Gbps CDN nodes.",
    providers: "StreamB4, UK Stream 4K, 4K German IPTV, Ultra 8K",
    impact: "High",
    impactClass: "badge-high"
  },
  {
    feature: "VPN Compatibility & SSL Tunneling",
    why: "Allows clients to bypass aggressive ISP throttling (Sky, Virgin, BT, Comcast, AT&T) without speed loss.",
    providers: "StreamB4, Roku Stream, Stream Germany 4K",
    impact: "Medium",
    impactClass: "badge-medium"
  },
  {
    feature: "EPG TV Guide & 7-Day Catch-Up",
    why: "Electronic Program Guide provides full channel schedules, search, and replay capabilities for missed shows.",
    providers: "StreamB4, UK Stream 4K, Ultra 8K, IPTV Smarters FR",
    impact: "Medium",
    impactClass: "badge-medium"
  },
  {
    feature: "Flexible Reseller Credit System",
