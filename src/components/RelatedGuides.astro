---
// "Keep reading" block appended to the hand-written blog posts (they are separate .astro files).
import { articles } from '../data/articles.mjs';
import { staticPosts } from '../data/static-posts.mjs';
interface Props { current: string; slugs: string[] }
const { current, slugs } = Astro.props;
const pool = [
  ...articles.map((a: any) => ({ slug: a.slug, title: a.title, text: a.description })),
  ...staticPosts.map((p: any) => ({ slug: p.slug, title: p.title, text: p.excerpt })),
];
const items = slugs.filter((s) => s !== current).map((s) => pool.find((p) => p.slug === s)).filter(Boolean);
---

{items.length > 0 && (
  <section class="rg">
    <div class="container rg-wrap">
      <h2>Keep reading</h2>
      <ul>
        {items.map((r: any) => <li><a href={`/blog/${r.slug}`} class="rg-card glass-card"><span class="rg-title">{r.title}</span><span class="rg-text">{r.text}</span></a></li>)}
      </ul>
      <p class="rg-more"><a href="/blog">All guides</a> &middot; <a href="/tools">Free tools</a> &middot; <a href="/all-devices">Device set-up guides</a> &middot; <a href="/pricing">IPTV plans</a> &middot; <a href="/iptv-free-trial">Free trial</a></p>
    </div>
  </section>
)}

<style>
  .rg { padding: 10px 0 70px; }
  .rg-wrap { max-width: 1100px; }
  .rg h2 { font-size: 1.3rem; margin-bottom: 14px; }
  .rg ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 12px; }
  .rg-card { display: grid; gap: 6px; padding: 16px; height: 100%; }
  .rg-title { font-weight: 700; color: #fff; line-height: 1.35; }
  .rg-text { color: #94a3b8; font-size: 0.86rem; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .rg-more { margin-top: 16px; color: #94a3b8; font-size: 0.9rem; }
  .rg-more a { color: #38bdf8; padding: 6px 2px; display: inline-block; }
</style>
