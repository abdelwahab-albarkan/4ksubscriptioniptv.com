<!-- ==================== LIVE SHOWCASE GALLERY ==================== -->
<section class="gallery-section section-padding-lg" id="gallery">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-badge"><i class="fa-solid fa-camera"></i> Studio Visual Proof</span>
      <h2 class="section-title">Live 4K HDR <span class="gradient-text">Broadcast Quality Showcase</span></h2>
      <p class="section-description">
        Real uncompressed broadcast snapshots captured directly from our subscriber network. Zero pixelation, silky-smooth 60FPS motion, and deep cinematic HDR color contrast.
      </p>
    </div>

    <!-- Gallery Category Filter Buttons -->
    <div class="gallery-filters" id="gallery-filters-container">
      <button class="filter-btn active" data-filter="all"><i class="fa-solid fa-border-all"></i> All Snapshots</button>
      <button class="filter-btn" data-filter="sports"><i class="fa-solid fa-trophy"></i> Live 4K Sports</button>
      <button class="filter-btn" data-filter="cinema"><i class="fa-solid fa-film"></i> 200k+ VOD Cinema</button>
      <button class="filter-btn" data-filter="living-room"><i class="fa-solid fa-couch"></i> 4K OLED Living Rooms</button>
      <button class="filter-btn" data-filter="multiscreen"><i class="fa-solid fa-table-cells-large"></i> Multi-Screen Wall</button>
    </div>

    <!-- Responsive Showcase Grid -->
    <div class="gallery-grid" id="gallery-grid-cards">
      {galleryItems.map((item) => (
        <div class="gallery-card glass-card" data-category={item.category}>
          <div class="gallery-img-wrap">
            <img src={item.img} alt={item.title} class="gallery-img" loading="lazy" />
            <div class="gallery-img-overlay">
              <span class="gallery-quality-badge"><i class="fa-solid fa-bolt text-warning"></i> {item.quality}</span>
              <span class="gallery-tag"><i class={item.icon}></i> {item.tag}</span>
            </div>
          </div>
          <div class="gallery-info">
            <div class="gallery-title-row">
              <h4>{item.title}</h4>
            </div>
            <p>{item.sub}</p>
            <div class="gallery-card-footer">
              <span class="stream-protocol"><i class="fa-solid fa-shield-halved"></i> Anti-Freeze v9.2</span>
              <span class="stream-fps"><i class="fa-solid fa-gauge-high"></i> 60 FPS</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll('#gallery-filters-container .filter-btn');
  const galleryCards = document.querySelectorAll('#gallery-grid-cards .gallery-card');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      filterButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      galleryCards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = 'flex';
          card.classList.add('fade-in');
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .gallery-section {
    padding: 85px 0;
    position: relative;
    overflow: hidden;
  }

  .gallery-filters {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin: 32px 0 42px 0;
  }

  .filter-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    padding: 9px 18px;
    border-radius: 9999px;
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: inherit;
  }

  .filter-btn:hover {
    background: rgba(59, 130, 246, 0.15);
    color: #ffffff;
    border-color: rgba(59, 130, 246, 0.35);
  }

  .filter-btn.active {
    background: linear-gradient(135deg, #2563eb 0%, #0284c7 100%);
    color: #ffffff;
    border-color: rgba(59, 130, 246, 0.6);
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.35);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 26px;
  }

  .gallery-card {
    background: rgba(13, 20, 38, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(10px);
  }

  .gallery-card:hover {
    transform: translateY(-7px);
    border-color: rgba(59, 130, 246, 0.45);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.55), 0 0 25px rgba(59, 130, 246, 0.2);
  }

  .gallery-img-wrap {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: #000000;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
  }

  .gallery-card:hover .gallery-img {
    transform: scale(1.08);
  }

  .gallery-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 10, 20, 0.85) 0%, rgba(7, 10, 20, 0.1) 60%, transparent 100%);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 14px;
    pointer-events: none;
  }

  .gallery-quality-badge {
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(245, 158, 11, 0.4);
