---
import siteConfig from '../data/site-config.json';
import { fromUsd, fromGbp } from '../lib/pricing';

interface Props {
  targetKeyword: string;
  secondaryKeywords?: string[];
  h1: string;
  country?: string;
  locationName?: string;
  deviceName?: string;
  sportName?: string;
  category?: string;
  semrush?: {
    volume: number;
    kd: number;
    cpc: number;
    intent: string;
  };
}

const {
  targetKeyword,
  secondaryKeywords = [],
  h1,
  country = "USA & UK",
  locationName,
  deviceName,
  sportName,
  category = "us-geo",
  semrush
} = Astro.props;

// Intent detection
const isUk = category === 'uk-geo' || country === 'United Kingdom' || (locationName && locationName.includes('UK')) || targetKeyword.toLowerCase().includes('uk');
const isDevice = category === 'device' || Boolean(deviceName) || targetKeyword.toLowerCase().includes('firestick') || targetKeyword.toLowerCase().includes('tv') || targetKeyword.toLowerCase().includes('apple') || targetKeyword.toLowerCase().includes('shield');
const isSport = category === 'sports' || Boolean(sportName) || targetKeyword.toLowerCase().includes('league') || targetKeyword.toLowerCase().includes('sports') || targetKeyword.toLowerCase().includes('nfl') || targetKeyword.toLowerCase().includes('ufc') || targetKeyword.toLowerCase().includes('cup');
const isIntent = category === 'intent' || targetKeyword.toLowerCase().includes('trial') || targetKeyword.toLowerCase().includes('reseller') || targetKeyword.toLowerCase().includes('buy') || targetKeyword.toLowerCase().includes('best') || targetKeyword.toLowerCase().includes('anti-freeze');

const locationTitle = locationName || country;
const hardwareName = deviceName || targetKeyword;
const liveSportName = sportName || "Premier League 3PM & NFL Sports";

// Deterministic seed generator for high semantic divergence across 1,600+ programmatic pages
function getSeed(str: string): number {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = (hash << 5) - hash + str.charCodeAt(i);
    hash |= 0;
  }
  return Math.abs(hash);
}

const seed = getSeed(targetKeyword + (locationName || '') + h1);
const variant = seed % 4;

// Filter secondary keywords to remove irrelevant queries like "best tvs" or "pink ipad"
const relevantKeywords = secondaryKeywords.filter((kw) => {
  const k = kw.toLowerCase();
  // Filter out irrelevant appliance / generic hardware terms
  if (k.includes('refrigerator') || k.includes('ipad') || k.includes('fridge') || k.includes('pink') || k.includes('55 inch') || k.includes('65 inch') || k.includes('32 inch') || k.includes('shop tvs') || k.includes('tvs on sale')) {
    return false;
  }
  return true;
}).slice(0, 14);

// Dynamic unique lead intros based on variant
const leadIntros = [
  `Streaming uncompressed live broadcasts and 4K video-on-demand in ${locationTitle} demands a low-latency, unmetered network infrastructure. ${siteConfig.siteName} powers ${h1} with dedicated 10Gbps load-balanced edge clusters, delivering studio-grade 60FPS sports feeds with sub-10ms buffer latency.`,
  `For viewers and cord-cutters searching for ${targetKeyword} in ${locationTitle}, server stability and ISP anti-throttling are paramount. Backed by proprietary Anti-Freeze Protocol v9.2, our network routes streams through private CDN tunnels in London, New York, and Frankfurt.`,
  `Cutting the cable cord and upgrading to ${h1} allows households in ${locationTitle} to save over 90% annually while gaining instant access to 51,000+ live channels, 200,000+ movies, and 24/7 technical support.`,
  `Engineered specifically for high-bitrate streaming demands in ${locationTitle}, our server cluster eliminates buffering, packet loss, and live broadcast delays across all major streaming devices and apps.`
];
---

<section class="seo-content-section" id="seo-deep-guide">
  <div class="container">
    <div class="seo-content-card glass-card">
      
      <!-- Top Keyword Insights Banner -->
      <div class="keyword-meta-banner">
        <div class="kw-badge">
          <span class="pulse-dot"></span>
          <span>Target Topic: <strong>{targetKeyword}</strong></span>
        </div>
        {semrush && (
          <div class="semrush-stats-strip">
            <span class="s-tag">🔥 Search Demand: <strong>{semrush.volume.toLocaleString()} searches/mo</strong></span>
            <span class="s-tag">🎯 Intent: <strong>{semrush.intent || (isDevice ? 'Technical Setup' : isSport ? 'Live Broadcast' : isUk ? 'UK Geo Intent' : 'Commercial')}</strong></span>
            <span class="s-tag">⚡ KD Score: <strong>{semrush.kd}% (High Intent)</strong></span>
          </div>
        )}
      </div>

      <!-- Rich Semantic Article Body -->
      <div class="seo-article">
        <h2>Complete Technical Guide &amp; Review for <span class="gradient-text">{h1}</span> (2026 Edition)</h2>
        
        <p class="article-lead">
          {leadIntros[variant]}
        </p>

        <!-- Blueprint 1: UK Local Network & ISP Anti-Throttling (uk-geo) -->
        {isUk && (
          <div class="intent-block uk-intent-block">
            <div class="intent-header">
              <div class="intent-icon"><i class="fa-solid fa-shield-halved"></i></div>
              <div>
                <h3>UK ISP Anti-Throttling &amp; 3PM Blackout Guide ({locationTitle})</h3>
                <p>How to bypass BT, Sky Broadband Shield, and Virgin Media WebSafe throttling</p>
              </div>
            </div>
            <div class="intent-grid">
              <div class="intent-card">
                <h4><i class="fa-solid fa-lock text-accent"></i> 1.1.1.1 Secure DNS &amp; TLS 443 Tunneling</h4>
                <p>
                  Major UK internet service providers (BT, Virgin Media, Sky, TalkTalk, EE) enforce dynamic DNS filtering during live Premier League match windows. {siteConfig.siteName} incorporates direct Cloudflare 1.1.1.1 encrypted DNS routing and SSL tunneling (Ports 8080 &amp; 443) so your stream remains 100% buffer-free without needing a VPN.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-futbol text-accent"></i> 3PM Premier League Blackout Bypass</h4>
                <p>
                  Under the UK Article 48 broadcasting blackout, Saturday 3:00 PM kickoffs cannot be shown on domestic UK television. Our network provides direct feeds from international 4K broadcasters (Optus Sport, Peacock, SuperSport, beIN), giving you every single fixture live in 50/60FPS.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-tower-broadcast text-accent"></i> London &amp; Manchester CDN Nodes</h4>
                <p>
                  Our UK stream routing latency averages under 8ms thanks to low-latency edge POPs situated directly in Equinix LD4 (Slough) and Manchester, providing continuous 35Mbps throughput for live Sky Sports Main Event and TNT Sports 4K UHD.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-sterling-sign text-accent"></i> Save £900+ Annually on Sky &amp; Virgin</h4>
                <p>
                  A full Sky Q or Virgin Media Stream package with Sky Sports, TNT Sports, and Cinema easily exceeds £95/month. {siteConfig.siteName} offers all 51,000+ UK &amp; international channels and 200,000+ VODs for only {fromGbp}/month with zero contracts.
                </p>
              </div>
            </div>
          </div>
        )}

        <!-- Blueprint 2: US Local Network & Regional Sports Networks (us-geo) -->
        {!isUk && !isDevice && !isSport && (
          <div class="intent-block us-intent-block">
            <div class="intent-header">
              <div class="intent-icon"><i class="fa-solid fa-server"></i></div>
              <div>
                <h3>USA Out-of-Market Sports &amp; Cable Cord-Cutting ({locationTitle})</h3>
                <p>Stream regional NBC, CBS, FOX, ABC, Bally Sports &amp; NFL Sunday Ticket</p>
              </div>
            </div>
            <div class="intent-grid">
              <div class="intent-card">
                <h4><i class="fa-solid fa-tv text-accent"></i> Out-of-Market NFL, NBA &amp; MLB</h4>
                <p>
                  Never get blacked out from your home team when traveling or living out of state. Stream every Sunday afternoon NFL game, NFL RedZone with Scott Hanson, NBA League Pass feeds, and local Regional Sports Networks (YES Network, NESN, Marquee, Bally Sports) in native 60FPS.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-piggy-bank text-accent"></i> Save Over $1,400 / Year on Cable</h4>
                <p>
                  Traditional US cable providers (Comcast Xfinity, Spectrum, Cox, DirecTV) charge an average of $135/month with hidden broadcast TV fees and hardware rental surcharges. {siteConfig.siteName} provides 10x more content for only {fromUsd}/month with zero contracts.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-network-wired text-accent"></i> US Edge Cluster (NYC, Dallas, Chicago)</h4>
                <p>
                  Direct peerings with Comcast, AT&amp;T Fiber, Verizon Fios, Spectrum, and CenturyLink ensure smooth packet delivery without throttling during peak primetime and Sunday football windows.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-building-columns text-accent"></i> Local News &amp; Weather Channels</h4>
                <p>
                  Access local affiliate feeds for CBS, NBC, ABC, FOX, and The CW from all 210 US media designated market areas (DMAs), ensuring you never miss local news, weather alerts, or regional sports.
                </p>
              </div>
            </div>
          </div>
        )}

        <!-- Blueprint 3: Hardware & Device Buffer Optimization (device) -->
        {isDevice && (
          <div class="intent-block device-intent-block">
            <div class="intent-header">
              <div class="intent-icon"><i class="fa-solid fa-microchip"></i></div>
              <div>
                <h3>Hardware Optimization &amp; Buffer Cache Blueprint ({hardwareName})</h3>
                <p>Configure memory buffer and hardware acceleration for 4K 60FPS playback</p>
              </div>
            </div>
            <div class="intent-grid">
              <div class="intent-card">
                <h4><i class="fa-solid fa-memory text-accent"></i> 100MB Memory Buffer Setup</h4>
                <p>
                  In TiviMate, IPTV Smarters Pro, or IBO Player, navigate to <strong>Settings &rarr; Playback &rarr; Buffer Size</strong> and select <strong>Large (100MB)</strong>. This allows {hardwareName} to preload 15 seconds of uncompressed video ahead of time, eliminating micro-stutters during network spikes.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-bolt text-accent"></i> Hardware Video Decoding (HW+ / MediaCodec)</h4>
                <p>
                  Ensure your player app is set to <strong>Hardware Decoding (HW+)</strong> rather than Software Decoding. This offloads H.265 HEVC 4K decoding to your dedicated GPU processor, keeping device CPU temperature low and delivering crisp 60FPS rendering.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-sliders text-accent"></i> Auto Frame Rate Matching (AFR)</h4>
                <p>
                  Enable Auto Frame Rate (AFR) in your player settings. This automatically syncs your TV display refresh rate (50Hz for UK football, 60Hz for US sports, 24Hz for 4K movies), preventing judder and motion blur.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-volume-high text-accent"></i> Dolby Digital Plus 5.1 Passthrough</h4>
                <p>
                  Enable Audio Passthrough in your sound settings to output true multi-channel surround sound directly to your soundbar or AV home cinema receiver for stadium-like audio.
                </p>
              </div>
            </div>
          </div>
        )}

        <!-- Blueprint 4: Live Sports & Low-Latency Broadcasts (sports) -->
        {isSport && (
          <div class="intent-block sports-intent-block">
            <div class="intent-header">
              <div class="intent-icon"><i class="fa-solid fa-trophy"></i></div>
              <div>
                <h3>Live Sports Broadcast &amp; Anti-Freeze Streaming Engine ({liveSportName})</h3>
                <p>High-frame-rate 60FPS stadium feeds with ultra-low latency &amp; multi-audio commentary</p>
              </div>
            </div>
            <div class="intent-grid">
              <div class="intent-card">
                <h4><i class="fa-solid fa-gauge-high text-accent"></i> Native 60FPS &amp; 50FPS Stadium Feeds</h4>
                <p>
                  Fast-moving sports require high frame rates. While inferior IPTV providers downscale to 25/30FPS causing ball ghosting, {siteConfig.siteName} broadcasts {liveSportName} in true native 50/60FPS with 15–35 Mbps bitrates.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-stopwatch text-accent"></i> Low-Latency Real-Time Protocol</h4>
                <p>
                  Our direct satellite downlink and private fiber backhaul keep stream latency under 8 seconds behind live on-pitch action, so your social feeds or betting notifications never spoil goals before they happen on your screen.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-earth-americas text-accent"></i> Worldwide Multi-Broadcaster Feeds</h4>
                <p>
                  Access multiple commentary languages and camera angles across Sky Sports, TNT Sports, Peacock TV, DAZN, Optus Sport, SuperSport, beIN Sports, and ESPN+, ensuring full coverage regardless of geographical restrictions.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-clock-rotate-left text-accent"></i> 7-Day Catch-up &amp; Instant Replay</h4>
                <p>
                  Missed the kickoff? Use the interactive 7-day catch-up feature to rewind to the start of the match or replay key match highlights at any time in full 1080p/4K resolution.
                </p>
              </div>
            </div>
          </div>
        )}

        <!-- Blueprint 5: Commercial, Provisioning & Reseller Panel SLA (intent) -->
        {isIntent && (
          <div class="intent-block commercial-intent-block">
            <div class="intent-header">
              <div class="intent-icon"><i class="fa-solid fa-server"></i></div>
              <div>
                <h3>Automated Provisioning &amp; Server Infrastructure SLA</h3>
                <p>3-minute instant dispatch, Xtream Codes API integration, and multi-connection scalability</p>
              </div>
            </div>
            <div class="intent-grid">
              <div class="intent-card">
                <h4><i class="fa-solid fa-bolt text-accent"></i> 3-Minute Automated Activation</h4>
                <p>
                  Our fully automated dispatch gateway generates your Xtream Codes API login (Server URL, Port, Username, Password) and M3U Plus playlist link immediately upon completed checkout. Details arrive directly to your WhatsApp and Email.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-users-viewfinder text-accent"></i> Multi-Room Household Connections</h4>
                <p>
                  Stream concurrently on up to 5 devices in your household with dedicated sub-tokens, allowing family members to watch live sports, movies, and news on different screens simultaneously without bandwidth collisions.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-chart-line text-accent"></i> Reseller Panel &amp; Sub-Reseller Architecture</h4>
                <p>
                  Looking to start your own IPTV business? Our Xtream UI / 1-Stream panel provides full credit management, 24-hour free trial generation, MAG/Stalker portal mapping, and complete client DNS customization.
                </p>
              </div>
              <div class="intent-card">
                <h4><i class="fa-solid fa-shield-halved text-accent"></i> 100% Risk-Free 7-Day Money Back SLA</h4>
                <p>
                  Test our network stability with complete peace of mind. If you experience technical buffering or server downtime that our 24/7 WhatsApp engineers cannot resolve, you receive a prompt 100% refund.
                </p>
              </div>
            </div>
          </div>
        )}

        <!-- 4 Core Service Advantages Grid -->
        <div class="seo-highlights-grid">
          <div class="highlight-item">
            <div class="h-icon"><i class="fa-solid fa-trophy"></i></div>
            <h4>51,000+ Channels &amp; 200,000+ VOD</h4>
            <p>
              Access all live sports (Premier League, NFL, Champions League, UFC, NBA, F1), local news, entertainment, and a massive 4K movie &amp; TV series library updated daily.
            </p>
          </div>

          <div class="highlight-item">
            <div class="h-icon"><i class="fa-solid fa-bolt"></i></div>
            <h4>3-Minute Automated Activation</h4>
            <p>
              Instant delivery of your Xtream Codes API credentials (Server URL, Username, Password) and M3U playlist format directly to your WhatsApp and email.
            </p>
          </div>

          <div class="highlight-item">
            <div class="h-icon"><i class="fa-solid fa-mobile-screen"></i></div>
            <h4>Multi-Device Multi-Room Access</h4>
            <p>
              Stream on Amazon Firestick 4K, Apple TV, Samsung Tizen, LG webOS, Android TV, TiviMate, Windows, and smartphones with up to 5 simultaneous household connections.
            </p>
          </div>

          <div class="highlight-item">
            <div class="h-icon"><i class="fa-solid fa-headset"></i></div>
            <h4>24/7 Dedicated WhatsApp Support</h4>
            <p>
              Our team of streaming engineers is available around the clock to assist with Downloader setup, playlist synchronization, and anti-freeze stream optimization.
            </p>
          </div>
        </div>

        <!-- Semrush Relevant Keywords Cloud -->
        {relevantKeywords.length > 0 && (
          <div class="secondary-keywords-box">
            <h4>Semrush Verified Search Topics Covered in This Guide:</h4>
            <div class="keywords-cloud">
              {relevantKeywords.map((kw) => (
                <span class="kw-pill">
                  <i class="fa-solid fa-magnifying-glass"></i>
                  {kw}
                </span>
              ))}
            </div>
          </div>
        )}

      </div>
    </div>
  </div>
</section>

<style>
  .seo-content-section {
    padding: 70px 0;
  }

  .seo-content-card {
    padding: 40px 34px;
    background: rgba(13, 20, 38, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
  }

  .keyword-meta-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 30px;
  }

  .kw-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.35);
    color: #60a5fa;
    padding: 6px 16px;
    border-radius: 9999px;
    font-size: 0.86rem;
  }

  .kw-badge strong {
    color: #ffffff;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10b981;
  }

  .semrush-stats-strip {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .s-tag {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 5px 12px;
    border-radius: 8px;
    font-size: 0.78rem;
    color: #cbd5e1;
  }

  .s-tag strong {
    color: #38bdf8;
  }

  .seo-article h2 {
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    margin-bottom: 16px;
    color: #ffffff;
    line-height: 1.3;
  }

  .article-lead {
    font-size: 1.05rem;
    color: #cbd5e1;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .article-lead strong {
    color: #ffffff;
  }

  /* Intent Blocks */
  .intent-block {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 16px;
    padding: 28px 24px;
    margin-bottom: 36px;
  }

  .uk-intent-block {
    border-color: rgba(56, 189, 248, 0.35);
    background: linear-gradient(180deg, rgba(14, 30, 60, 0.8) 0%, rgba(15, 23, 42, 0.85) 100%);
  }

  .sports-intent-block {
    border-color: rgba(16, 185, 129, 0.35);
    background: linear-gradient(180deg, rgba(10, 40, 30, 0.8) 0%, rgba(15, 23, 42, 0.85) 100%);
  }

  .device-intent-block {
    border-color: rgba(168, 85, 247, 0.35);
    background: linear-gradient(180deg, rgba(35, 20, 60, 0.8) 0%, rgba(15, 23, 42, 0.85) 100%);
  }

  .commercial-intent-block {
    border-color: rgba(245, 158, 11, 0.35);
    background: linear-gradient(180deg, rgba(45, 30, 10, 0.8) 0%, rgba(15, 23, 42, 0.85) 100%);
  }

  .intent-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }

  .intent-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #2563eb 0%, #0284c7 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .intent-header h3 {
    font-size: 1.2rem;
    color: #ffffff;
    margin-bottom: 2px;
  }

  .intent-header p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .intent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 18px;
  }

  .intent-card {
    background: rgba(10, 15, 30, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 18px;
  }

  .intent-card h4 {
    font-size: 0.98rem;
    color: #ffffff;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .intent-card p {
    font-size: 0.86rem;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0;
  }

  .text-accent {
    color: #38bdf8;
  }

  /* Highlights Grid */
  .seo-highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 20px;
    margin-bottom: 35px;
  }

  .highlight-item {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 22px;
    transition: all 0.3s ease;
  }

  .highlight-item:hover {
    transform: translateY(-4px);
    border-color: rgba(59, 130, 246, 0.4);
  }

  .h-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(6, 182, 212, 0.2) 100%);
    border: 1px solid rgba(59, 130, 246, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #38bdf8;
    font-size: 1.1rem;
    margin-bottom: 14px;
  }

  .highlight-item h4 {
    font-size: 1rem;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .highlight-item p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* Keywords Cloud */
  .secondary-keywords-box {
    background: rgba(10, 15, 30, 0.7);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 20px;
  }

  .secondary-keywords-box h4 {
    font-size: 0.88rem;
    color: #cbd5e1;
    margin-bottom: 12px;
  }

  .keywords-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .kw-pill {
    font-size: 0.76rem;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.25);
    color: #93c5fd;
    padding: 4px 10px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .kw-pill i {
    font-size: 0.65rem;
    color: #38bdf8;
  }

  @media (max-width: 768px) {
    .seo-content-card {
      padding: 24px 18px;
    }
  }
</style>
