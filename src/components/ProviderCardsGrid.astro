---

<!-- ==================== PROVIDERS SECTION - ALL 12 DETAILED ==================== -->
<section class="providers-section section-padding-lg" id="providers">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-badge"><i class="fa-solid fa-server"></i> Official Server Network 2026</span>
      <h2 class="section-title">Explore Our 12 Global <span class="gradient-text">Streaming Server Clusters</span></h2>
      <p class="section-description">
        Access our certified international network of dedicated 4K/8K IPTV nodes, sports streaming servers, and wholesale reseller panels covering the US, UK, Germany, France, Spain, and global markets.
      </p>
    </div>

    <div class="provider-grid">
      {providers.map((p) => (
        <div class={`provider-card glass-card ${p.featured ? 'featured-provider' : ''}`} id={p.id}>
          <div class="card-top-badges">
            <span class={`provider-rank ${p.rankClass}`}>
              <i class="fa-solid fa-trophy"></i> {p.rank}
            </span>
            <span class="provider-badge-premium">
              <i class="fa-solid fa-fire"></i> {p.badge}
            </span>
          </div>

          <div class="provider-icon-wrap">
            <i class={`fa-solid ${p.icon} provider-icon`}></i>
          </div>

          <h3>{p.name}</h3>

          <div class="provider-rating">
            <div class="stars">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
            </div>
            <span class="rating-val">{p.rating}</span>
            <small>({p.reviews})</small>
          </div>

          <p class="provider-description">{p.description}</p>

          <div class="provider-highlights">
            {p.highlights.map((h) => (
              <span class="highlight-tag">
                <i class="fa-solid fa-server"></i> {h}
              </span>
            ))}
          </div>

          <ul class="provider-features-list">
            {p.features.map((f) => (
              <li>
                <i class="fa-solid fa-check-circle"></i>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <div class="provider-pricing">
            <div class="price-tag">
              <span class="price-amount">{p.price}</span>
              <span class="price-period">{p.period}</span>
            </div>
            <span class="price-trial">
              <i class="fa-solid fa-clock"></i> {p.trial}
            </span>
          </div>

          <div class="provider-actions">
            <a href={p.url} class="btn btn-primary btn-lg full-width pulse-animation" target="_blank" rel="noopener nofollow sponsored">
              <i class="fa-solid fa-globe"></i> Visit {p.domain} ↗
            </a>
            <a href={siteConfig.whatsappUrl} class="btn btn-outline btn-lg full-width" target="_blank" rel="noopener">
              <i class="fa-brands fa-whatsapp text-whatsapp"></i> Get 24H Trial on WhatsApp
            </a>
            <a href="#pricing" class="btn btn-accent btn-sm full-width">
              <i class="fa-solid fa-tags"></i> View All Subscription Plans
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- View All Providers CTA -->
    <div class="view-all-wrap text-center">
      <a href="#comparison-table" class="btn btn-secondary btn-xl">
        <i class="fa-solid fa-scale-balanced"></i> Compare Best IPTV 2026 Side-by-Side
      </a>
      <a href={siteConfig.whatsappUrl} class="btn btn-primary btn-xl pulse-animation" target="_blank" rel="noopener">
        <i class="fa-solid fa-headset"></i> Get Reseller Panel Access Now
      </a>
    </div>
  </div>
</section>

<style>
  .providers-section {
    padding: 80px 0;
  }

  .provider-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 350px), 1fr));
    gap: 30px;
    margin-top: 50px;
  }

  .provider-card {
    background: rgba(13, 20, 38, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.35s ease;
  }

  .provider-card:hover {
    transform: translateY(-7px);
    border-color: rgba(59, 130, 246, 0.45);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
  }

  .featured-provider {
    border-color: rgba(59, 130, 246, 0.4);
    background: linear-gradient(180deg, rgba(20, 32, 60, 0.85) 0%, rgba(13, 20, 38, 0.95) 100%);
  }

  .card-top-badges {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .provider-rank {
    font-size: 0.76rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.5px;
  }

  .top-rated {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.4);
  }

  .top-choice {
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.4);
  }

  .standard-rank {
    background: rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .provider-badge-premium {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.35);
    font-size: 0.74rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .provider-icon-wrap {
    width: 54px;
    height: 54px;
    background: linear-gradient(135deg, #2563eb 0%, #0284c7 100%);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 1.5rem;
    margin-bottom: 16px;
    box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4);
  }

  .provider-card h3 {
    font-size: 1.4rem;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .provider-rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .stars {
    color: #fbbf24;
    font-size: 0.88rem;
    display: flex;
    gap: 2px;
  }

  .rating-val {
    font-weight: 700;
    color: #ffffff;
    font-size: 0.88rem;
  }

  .provider-rating small {
    color: var(--text-dim);
    font-size: 0.78rem;
  }

  .provider-description {
    font-size: 0.88rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .provider-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 22px;
  }

  .highlight-tag {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #38bdf8;
    font-size: 0.74rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .provider-features-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 18px;
  }

  .provider-features-list li {
    font-size: 0.85rem;
    color: #e2e8f0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .provider-features-list li i {
    color: #10b981;
    font-size: 0.88rem;
    flex-shrink: 0;
  }

  .provider-pricing {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 20px;
  }

  .price-amount {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    color: #ffffff;
  }

  .price-period {
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .price-trial {
    font-size: 0.78rem;
    font-weight: 700;
    color: #34d399;
    background: rgba(16, 185, 129, 0.15);
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .provider-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .view-all-wrap {
    margin-top: 50px;
    display: flex;
